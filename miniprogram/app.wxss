/* 同乐八字 - 全局样式（新中式国风） */
/* 主色：朱砂红 #B3402A  辅色：鎏金 #B98E4A  墨色 #33302B  宣纸底 #F6F1E7 */

page {
  background: #F6F1E7;
  color: #33302B;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --primary: #B3402A;
  --primary-deep: #93301E;
  --gold: #B98E4A;
  --ink: #33302B;
  --ink-2: #7A7264;
  --ink-3: #A89F8D;
  --paper: #F6F1E7;
  --card: #FFFDF8;
  --line: #EAE2D0;
}

/* 衬线标题字 */
.serif {
  font-family: "Songti SC", "STSong", "SimSun", serif;
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 6rpx 24rpx rgba(90, 70, 40, 0.06);
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #C24E33, #9E3422);
  color: #FFF8EE;
  border-radius: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(158, 52, 34, 0.25);
}
.btn-primary::after {
  border: none;
}
.btn-primary.button-hover {
  opacity: 0.85;
}

/* 五行配色：木火土金水 */
.wx-mu { color: #3E8C5A; }
.wx-huo { color: #C0432B; }
.wx-tu { color: #8A6A2F; }
.wx-jin { color: #C2912E; }
.wx-shui { color: #3D6F9E; }

.bg-mu { background: #3E8C5A; }
.bg-huo { background: #C0432B; }
.bg-tu { background: #8A6A2F; }
.bg-jin { background: #C2912E; }
.bg-shui { background: #3D6F9E; }

/* 文字辅助 */
.text-2 { color: var(--ink-2); }
.text-3 { color: var(--ink-3); }

/* 印章式 LOGO */
.seal {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #C24E33, #9E3422);
  color: #FFF6E8;
  border-radius: 14rpx;
  box-shadow: 0 6rpx 16rpx rgba(158, 52, 34, 0.3), inset 0 0 0 3rpx rgba(255, 246, 232, 0.55);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-weight: 700;
}
