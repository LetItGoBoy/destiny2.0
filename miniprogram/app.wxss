/* 同乐八字 - 全局样式（中国风 · 宫墙红 + 米白） */
/* 主色：宫墙红 #8A2B27  墨蓝近黑 #14152B  暖米白底 #F4EEE6  卡片白 #FFFFFF */

page {
  background: #F4EEE6;
  background-image: linear-gradient(180deg, #ECE0D0 0%, #F4EEE6 420rpx);
  background-repeat: no-repeat;
  background-size: 100% 100%;
  color: #14152B;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --primary: #8A2B27;
  --primary-deep: #6E1F1C;
  --cyan: #22D3EE;
  --pink: #EC5C8D;
  --gold: #C08A2B;
  --ink: #14152B;
  --ink-2: #5B5E78;
  --ink-3: #9A9CB5;
  --card: #FFFFFF;
  --line: rgba(20, 21, 60, 0.08);
  --fill: #F3EDE4;
  --tint: rgba(138, 43, 39, 0.10);
}

.page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-bg {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  opacity: 0.72;
  z-index: 0;
  pointer-events: none;
}

.page > view:not(.ss-mask):not(.cast-mask):not(.panel-mask):not(.panel):not(.savebar):not(.timebar):not(.overlay),
.page > scroll-view,
.page > button {
  position: relative;
  z-index: 1;
}

/* 内嵌圆体子集（得意黑 Smiley Sans，OFL 1.1 许可，仅含干支/五行/数字/固定单字，约 8KB）
   只用于字符集固定的元素，避免动态文案出现字体混排 */
@font-face {
  font-family: "TLRound";
  src: url(data:font/woff2;charset=utf-8;base64,) format("woff2");
}

/* 标题字：系统默认无衬线 */
.serif {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  letter-spacing: 1rpx;
}

/* 干支大字 / 单字印章 / 数字：字符集固定，直接吃内嵌圆体 */
.big-char, .core-seal, .seal, .cell-ico, .rec-ava, .fill-ch, .size-ch,
.sy-c, .sy-qian, .head-name, .yun-gz, .rgz, .bz-pillar, .cast-zhi,
.info-bazi, .acc-trait-char, .pattern-badge,
.pt-num, .pt-sv, .stat-num, .merit-num, .burn-done-ico {
  font-family: "TLRound", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

/* 卡片：白底柔投影 */
.card {
  background: var(--card);
  border-radius: 24rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 30rpx rgba(20, 21, 60, 0.06);
}

/* 主按钮：靛紫→电光青渐变 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #8A2B27, #A3382F);
  color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  line-height: 1;
  padding: 0;
  box-shadow: 0 12rpx 30rpx rgba(138, 43, 39, 0.32);
}
.btn-primary::after {
  border: none;
}
.btn-primary.button-hover {
  opacity: 0.88;
}

/* 五行配色（适配白底的深色版）：木火土金水 */
.wx-mu { color: #16A971; }
.wx-huo { color: #E85540; }
.wx-tu { color: #8C5E2A; }
.wx-jin { color: #D4A017; }
.wx-shui { color: #2E86E6; }

/* 五行实底（彩色圆点，配深字） */
.bg-mu { background: #34C88A; }
.bg-huo { background: #FF7A63; }
.bg-tu { background: #B07C34; }
.bg-jin { background: #E6B81F; }
.bg-shui { background: #5AA6F2; }

/* 文字辅助 */
.text-2 { color: var(--ink-2); }
.text-3 { color: var(--ink-3); }

/* LOGO 徽标（现代玻璃渐变） */
.seal {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #A3382F, #6E1F1C);
  color: #FFFFFF;
  border-radius: 22rpx;
  box-shadow: 0 10rpx 26rpx rgba(138, 43, 39, 0.35);
  font-weight: 700;
}
