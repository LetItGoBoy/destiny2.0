/* 页面跟随浅色主题，仅星图面板保持深色「太空」 */
.page {
  padding: 28rpx 28rpx 56rpx;
}

.head {
  padding: 8rpx 8rpx 24rpx;
}
.head-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.head-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
.head-bz {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: var(--gold);
  letter-spacing: 4rpx;
}

/* 星图面板：深色太空，面板内文字回到亮色 */
.sky-wrap {
  position: relative;
  padding: 0;
  overflow: hidden;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: radial-gradient(circle at 50% 32%, #1B2347 0%, #0C1026 70%, #070A1A 100%);
  border: 1rpx solid rgba(123, 107, 255, 0.3);
  box-shadow: 0 12rpx 32rpx rgba(30, 35, 90, 0.18);
  color: #F1EDFB;
  --ink-2: #C9CCE6;
  --ink-3: #AEB2D4;
  --primary: #B7A6FF;
  --gold: #E3C27E;
  --line: rgba(255, 255, 255, 0.14);
}
.sky-wrap .wx-mu { color: #5ED39A; }
.sky-wrap .wx-huo { color: #FF8A70; }
.sky-wrap .wx-tu { color: #E0B070; }
.sky-wrap .wx-jin { color: #F0D078; }
.sky-wrap .wx-shui { color: #7FB6FF; }
.sky {
  width: 100%;
  height: 840rpx;
  display: block;
}
.sky-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 16rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-3);
  pointer-events: none;
}
.flow-btn {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--primary);
  background: rgba(27, 21, 49, 0.85);
  border: 1rpx solid rgba(167, 139, 250, 0.45);
}
.flow-btn-on {
  color: var(--gold);
  border-color: rgba(227, 194, 126, 0.5);
}
.flow-label {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  background: rgba(27, 21, 49, 0.85);
  border: 1rpx solid var(--line);
}
.sel-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 100rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(27, 21, 49, 0.92);
  border: 1rpx solid var(--line);
  backdrop-filter: blur(8rpx);
}
.sel-name {
  font-size: 30rpx;
  font-weight: 700;
}
.sel-ancient {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  font-weight: 400;
}
.sel-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--ink-2);
}

/* 七政列表 */
.list-card {
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.list-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}
.li {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 25rpx;
}
.li:last-child {
  border-bottom: none;
}
.li-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.dot-sun { background: #FFD27D; box-shadow: 0 0 10rpx rgba(255, 210, 125, 0.8); }
.dot-moon { background: #E8E6F0; }
.dot-shui { background: #6FB6FF; }
.dot-jin { background: #F0D078; }
.dot-huo { background: #FF8A70; }
.dot-mu { background: #5ECC8F; }
.dot-tu { background: #D9A05B; }
.li-name {
  width: 96rpx;
  font-weight: 600;
}
.li-ancient {
  width: 88rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}
.li-wx {
  width: 56rpx;
  font-weight: 700;
}
.li-wx-dim {
  color: var(--ink-3);
  font-weight: 400;
}
.li-lon {
  flex: 1;
  color: var(--ink-2);
}
.li-zodiac {
  color: var(--ink-3);
  font-size: 22rpx;
}

/* 注解 */
.note-card {
  padding: 28rpx 32rpx;
}
.note-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}
.note-text {
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}
.note-text:last-child {
  margin-bottom: 0;
}

.footer {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

/* 字号档位 */
.fs-l .li { font-size: 28rpx; }
.fs-l .note-text { font-size: 27rpx; }
.fs-l .sel-desc { font-size: 27rpx; }
.fs-xl .li { font-size: 30rpx; }
.fs-xl .note-text { font-size: 30rpx; }
.fs-xl .sel-desc { font-size: 30rpx; }
