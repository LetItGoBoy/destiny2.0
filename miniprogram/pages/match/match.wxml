<view class="page">
  <view class="hero-ico hero-{{info.icoCls}} serif">{{info.ico}}</view>
  <view class="title serif">{{info.title}}</view>
  <view class="stamp serif">即将上线</view>
  <view class="desc">{{info.desc}}</view>

  <view class="card features">
    <view class="feature" wx:for="{{info.features}}" wx:key="*this">
      <view class="feature-dot"></view>
      <text>{{item}}</text>
    </view>
  </view>

  <button class="btn-primary btn-notify" bindtap="onNotify">上线提醒我</button>
  <view class="back" bindtap="goBack">返回排盘</view>
</view>
