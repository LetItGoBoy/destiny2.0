.page {
  padding: 28rpx 28rpx 60rpx;
}

/* 盘面 */
.pan {
  display: flex;
  padding: 24rpx 16rpx;
  margin-bottom: 18rpx;
}
.pan-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pan-day {
  background: var(--tint);
  border-radius: 14rpx;
}
.pan-label {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-bottom: 8rpx;
}
.pan-god {
  font-size: 21rpx;
  color: var(--ink-2);
  margin-bottom: 6rpx;
}
.pan-gz {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  gap: 2rpx;
}

/* 外在底色 */
.core {
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx;
}
.core-seal {
  flex-shrink: 0;
  width: 108rpx;
  height: 108rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 60rpx;
  font-weight: 700;
  margin-right: 26rpx;
}
.core-body {
  flex: 1;
  min-width: 0;
}
.core-title {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.core-text {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

/* 框架说明 */
.intro {
  padding: 18rpx 14rpx 4rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-2);
}
.intro .em {
  color: var(--primary);
  font-weight: 600;
}
.intro-note {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 两种底色：守正 / 求变 */
.pol {
  margin-top: 18rpx;
  padding: 28rpx 30rpx;
}
.pol-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 18rpx;
}
.pol-t {
  font-size: 30rpx;
  font-weight: 700;
}
.pol-sub {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
.pol-bar {
  display: flex;
  height: 52rpx;
  border-radius: 100rpx;
  overflow: hidden;
  background: var(--fill);
}
.pol-zheng, .pol-pian {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  transition: width 0.4s ease;
}
.pol-zheng { background: linear-gradient(135deg, #5BB58C, #2E8C63); }
.pol-pian { background: linear-gradient(135deg, #9D78F8, #6C4BD9); }
.pol-legend {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 22rpx;
}
.lg-zheng { color: #2E8C63; }
.lg-pian { color: #6C4BD9; }
.pol-shift {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--primary);
  background: var(--tint);
  border-radius: 10rpx;
  padding: 8rpx 16rpx;
  display: inline-block;
}

/* 心性构成 */
.comp {
  margin-top: 18rpx;
  padding: 28rpx 30rpx 12rpx;
}
.comp-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}
.comp-t {
  font-size: 30rpx;
  font-weight: 700;
}
.comp-sub {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
/* 当前旺衰状态 */
.ws-state {
  margin: 16rpx 0 12rpx;
  padding: 18rpx 20rpx;
  background: var(--fill);
  border-radius: 14rpx;
}
.ws-state-line {
  display: flex;
  align-items: center;
}
.ws-state-t {
  font-size: 24rpx;
  color: var(--ink-2);
  font-weight: 600;
}
.ws-state-v {
  margin-left: 14rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}
.ws-state-tag {
  margin-left: auto;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 14rpx;
  border-radius: 100rpx;
}
.tag-up { color: #C97A2B; background: rgba(224, 168, 90, 0.18); }
.tag-down { color: #2E86E6; background: rgba(90, 166, 242, 0.18); }
.tag-mid { color: var(--ink-2); background: rgba(20, 21, 60, 0.06); }
.ws-state-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.5;
}
.ws-shift {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--primary);
}

/* 优点(左) ←→ 缺点(右) 轴说明 */
.dax-cap {
  display: flex;
  justify-content: space-between;
  margin: 8rpx 2rpx 2rpx;
  font-size: 20rpx;
}
.cap-l { color: #1E9E6A; }
.cap-r { color: #C97A2B; }

.trait {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.trait:last-child {
  border-bottom: none;
}
.trait-line {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.trait-name {
  font-size: 32rpx;
  font-weight: 700;
}
.trait-tag {
  margin-left: 12rpx;
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.tag-z { color: #2E8C63; background: rgba(91, 181, 140, 0.16); }
.tag-p { color: #6C4BD9; background: rgba(157, 120, 248, 0.16); }
.trait-god {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
.trait-pct {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 700;
}
.pct-pro { color: #1E9E6A; }
.pct-con { color: #C97A2B; }
.pct-mid { color: var(--ink-3); }

/* 双向轴：中线为界，左优右缺 */
.dax {
  display: flex;
  align-items: center;
  height: 18rpx;
}
.dax-half {
  flex: 1;
  height: 100%;
  display: flex;
  background: var(--fill);
}
.dax-left { justify-content: flex-end; border-radius: 100rpx 0 0 100rpx; }
.dax-right { justify-content: flex-start; border-radius: 0 100rpx 100rpx 0; }
.dax-mid {
  width: 2rpx;
  height: 26rpx;
  background: var(--ink-3);
  opacity: 0.5;
  flex-shrink: 0;
}
.dax-fill {
  height: 100%;
  transition: width 0.4s ease;
}
.dax-pro { background: linear-gradient(135deg, #1E9E6A, #3FD09A); border-radius: 100rpx 0 0 100rpx; }
.dax-con { background: linear-gradient(135deg, #E0A85A, #C97A2B); border-radius: 0 100rpx 100rpx 0; }

.trait-shift {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--primary);
}
.trait-pc {
  margin-top: 12rpx;
}
.pc {
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--ink-3);
  margin-top: 4rpx;
}
.pc-on {
  color: var(--ink-2);
}
.pc-k {
  font-weight: 600;
  margin-right: 8rpx;
}
.pc-k-pro { color: #1E9E6A; }
.pc-k-con { color: #C97A2B; }
.comp-empty {
  padding: 30rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 岁运叠加 */
.luck {
  margin-top: 18rpx;
  padding: 26rpx 26rpx 20rpx;
}
.luck-cur {
  font-size: 24rpx;
  color: var(--primary);
  background: var(--tint);
  border-radius: 10rpx;
  padding: 12rpx 18rpx;
  margin-bottom: 22rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin: 8rpx 0 16rpx;
}
.section-note {
  font-size: 22rpx;
  color: var(--ink-3);
  font-weight: 400;
  margin-left: 12rpx;
}
.yun-scroll {
  white-space: nowrap;
  margin-bottom: 8rpx;
}
.yun-strip {
  display: inline-flex;
}
.yun-cell {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  width: 124rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  background: var(--fill);
}
.yun-on {
  background: var(--tint);
  border-color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(124, 92, 224, 0.3);
}
.yun-ss {
  font-size: 20rpx;
  color: var(--ink-3);
}
.yun-gz {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin: 4rpx 0;
}
.yun-year {
  font-size: 22rpx;
  color: var(--ink-2);
}
.yun-age {
  font-size: 20rpx;
  color: var(--ink-3);
}

.foot {
  margin-top: 36rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

/* 字号档位 */
.fs-l .core-text, .fs-l .pc, .fs-l .intro { font-size: 26rpx; }
.fs-xl .core-text, .fs-xl .pc, .fs-xl .intro { font-size: 29rpx; }
