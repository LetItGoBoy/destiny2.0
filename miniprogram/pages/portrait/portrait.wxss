.page {
  padding: 28rpx 28rpx 60rpx;
}

/* 盘面 */
.pan {
  display: flex;
  padding: 24rpx 16rpx;
  margin-bottom: 18rpx;
}
.pan-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pan-day {
  background: var(--tint);
  border-radius: 14rpx;
}
.pan-label {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-bottom: 8rpx;
}
.pan-god {
  font-size: 21rpx;
  color: var(--ink-2);
  margin-bottom: 6rpx;
}
.pan-gz {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  gap: 2rpx;
}

/* 外在底色 */
.core {
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx;
}
.core-seal {
  flex-shrink: 0;
  width: 108rpx;
  height: 108rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 60rpx;
  font-weight: 700;
  margin-right: 26rpx;
}
.core-body {
  flex: 1;
  min-width: 0;
}
.core-title {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.core-text {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

/* 框架说明 */
.intro {
  padding: 18rpx 14rpx 4rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-2);
}
.intro .em {
  color: var(--primary);
  font-weight: 600;
}
.intro-note {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 两种底色：守正 / 求变 */
.pol {
  margin-top: 18rpx;
  padding: 28rpx 30rpx;
}
.pol-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 18rpx;
}
.pol-t {
  font-size: 30rpx;
  font-weight: 700;
}
.pol-sub {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
.pol-bar {
  display: flex;
  height: 52rpx;
  border-radius: 100rpx;
  overflow: hidden;
  background: var(--fill);
}
.pol-zheng, .pol-pian {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  transition: width 0.4s ease;
}
.pol-zheng { background: linear-gradient(135deg, #5BB58C, #2E8C63); }
.pol-pian { background: linear-gradient(135deg, #9D78F8, #6C4BD9); }
.pol-legend {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 22rpx;
}
.lg-zheng { color: #2E8C63; }
.lg-pian { color: #6C4BD9; }
.pol-shift {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--primary);
  background: var(--tint);
  border-radius: 10rpx;
  padding: 8rpx 16rpx;
  display: inline-block;
}

/* 心性构成 */
.comp {
  margin-top: 18rpx;
  padding: 28rpx 30rpx 12rpx;
}
.comp-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}
.comp-t {
  font-size: 30rpx;
  font-weight: 700;
}
.comp-sub {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
/* 当前旺衰状态 */
.ws-state {
  margin: 16rpx 0 12rpx;
  padding: 18rpx 20rpx;
  background: var(--fill);
  border-radius: 14rpx;
}
.ws-state-line {
  display: flex;
  align-items: center;
}
.ws-state-t {
  font-size: 24rpx;
  color: var(--ink-2);
  font-weight: 600;
}
.ws-state-v {
  margin-left: 14rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}
.ws-state-tag {
  margin-left: auto;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 14rpx;
  border-radius: 100rpx;
}
.tag-up { color: #C97A2B; background: rgba(224, 168, 90, 0.18); }
.tag-down { color: #2E86E6; background: rgba(90, 166, 242, 0.18); }
.tag-mid { color: var(--ink-2); background: rgba(20, 21, 60, 0.06); }
.ws-state-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.5;
}
.ws-shift {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--primary);
}

/* 状态图例 */
.flow-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin: 6rpx 0 4rpx;
  padding: 0 2rpx;
}
.fl {
  font-size: 20rpx;
  color: var(--ink-3);
  position: relative;
  padding-left: 22rpx;
}
.fl::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-top: -7rpx;
  border-radius: 50%;
}
.fl-flow::before { background: #34C88A; }
.fl-mid::before { background: #B9BCD6; }
.fl-store::before { background: #9D78F8; }

.trait {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.trait:last-child {
  border-bottom: none;
}
.trait-major .trait-name {
  color: var(--primary);
}
.trait-line {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.trait-name {
  font-size: 32rpx;
  font-weight: 700;
}
.trait-tag {
  margin-left: 12rpx;
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.tag-z { color: #2E8C63; background: rgba(91, 181, 140, 0.16); }
.tag-p { color: #6C4BD9; background: rgba(157, 120, 248, 0.16); }
.flow-tag {
  margin-left: 10rpx;
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.flow-flow { color: #1E9E6A; background: rgba(52, 200, 138, 0.16); }
.flow-mid { color: #6E7290; background: rgba(20, 21, 60, 0.06); }
.flow-store { color: #6C4BD9; background: rgba(157, 120, 248, 0.16); }
.trait-god {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
.trait-pct {
  margin-left: auto;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}
.trait-track {
  height: 16rpx;
  border-radius: 100rpx;
  background: var(--fill);
  overflow: hidden;
}
.trait-fill {
  height: 100%;
  border-radius: 100rpx;
  transition: width 0.4s ease;
}
.fill-flow { background: linear-gradient(135deg, #3FD09A, #1E9E6A); }
.fill-mid { background: linear-gradient(135deg, #C7CAE0, #A8ABC9); }
.fill-store { background: linear-gradient(135deg, #9D78F8, #6C4BD9); }
.trait-shift {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--primary);
}
.trait-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink-2);
}
.comp-empty {
  padding: 30rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 岁运叠加 */
.luck {
  margin-top: 18rpx;
  padding: 26rpx 26rpx 20rpx;
}
.luck-cur {
  font-size: 24rpx;
  color: var(--primary);
  background: var(--tint);
  border-radius: 10rpx;
  padding: 12rpx 18rpx;
  margin-bottom: 22rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin: 8rpx 0 16rpx;
}
.section-note {
  font-size: 22rpx;
  color: var(--ink-3);
  font-weight: 400;
  margin-left: 12rpx;
}
.yun-scroll {
  white-space: nowrap;
  margin-bottom: 8rpx;
}
.yun-strip {
  display: inline-flex;
}
.yun-cell {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  width: 124rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  background: var(--fill);
}
.yun-on {
  background: var(--tint);
  border-color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(124, 92, 224, 0.3);
}
.yun-ss {
  font-size: 20rpx;
  color: var(--ink-3);
}
.yun-gz {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin: 4rpx 0;
}
.yun-year {
  font-size: 22rpx;
  color: var(--ink-2);
}
.yun-age {
  font-size: 20rpx;
  color: var(--ink-3);
}

.foot {
  margin-top: 36rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

/* 字号档位 */
.fs-l .core-text, .fs-l .trait-desc, .fs-l .intro { font-size: 27rpx; }
.fs-xl .core-text, .fs-xl .trait-desc, .fs-xl .intro { font-size: 30rpx; }
