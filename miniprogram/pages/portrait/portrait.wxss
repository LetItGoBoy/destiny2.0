.page {
  padding: 28rpx 28rpx 60rpx;
}

/* 外在底色 */
.core {
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx;
}

.core-seal {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 26rpx;
  color: #FFF7E4;
  background: linear-gradient(135deg, #8A2B27, #A3382F);
  box-shadow: 0 12rpx 30rpx rgba(138, 43, 39, 0.28);
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 3rpx 10rpx rgba(61, 7, 5, 0.42);
}

.core-body {
  flex: 1;
  min-width: 0;
}

.core-title {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.core-text {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.life-lead {
  margin-top: 22rpx;
  padding: 0 8rpx;
}

.life-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
}

.life-note {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: var(--ink-2);
}

/* 命局结构（食神制杀 / 羊刃驾杀 / 身杀两停） */
.pattern {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 24rpx 30rpx;
}

.pattern-badge {
  flex: none;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #8A5E12;
  background: rgba(201, 162, 39, 0.14);
  border: 1rpx solid rgba(201, 162, 39, 0.36);
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  margin-right: 22rpx;
  writing-mode: vertical-rl;
}

.pattern-body {
  flex: 1;
  min-width: 0;
}

.pattern-k {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ink-3);
  margin-bottom: 6rpx;
}

.pattern-t {
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--ink-2);
}

/* 两种底色：守正 / 求变 */
.pol {
  margin-top: 18rpx;
  padding: 28rpx 30rpx;
}

.pol-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 18rpx;
}

.pol-t {
  font-size: 30rpx;
  font-weight: 700;
}

.pol-sub {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.pol-bar {
  display: flex;
  height: 52rpx;
  border-radius: 100rpx;
  overflow: hidden;
  background: var(--fill);
}

.pol-zheng, .pol-pian {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  transition: width 0.4s ease;
}

.pol-zheng { background: linear-gradient(135deg, #5BB58C, #2E8C63); }

.pol-pian { background: linear-gradient(135deg, #9D78F8, #6C4BD9); }

.pol-verdict {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: var(--tint);
  border-left: 6rpx solid var(--primary);
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--ink);
}

.pol-explain {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.pol-explain-item {
  flex: 1;
  min-width: 0;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid transparent;
}

.pol-explain-zheng {
  background: rgba(91, 181, 140, 0.12);
  border-color: rgba(46, 140, 99, 0.22);
}

.pol-explain-pian {
  background: rgba(108, 75, 217, 0.11);
  border-color: rgba(108, 75, 217, 0.22);
}

.pol-explain-k {
  display: block;
  font-size: 23rpx;
  font-weight: 800;
  margin-bottom: 4rpx;
}

.pol-explain-t {
  display: block;
  font-size: 21rpx;
  line-height: 1.45;
  color: var(--ink-2);
}

.pol-explain-zheng .pol-explain-k { color: #2E8C63; }

.pol-explain-pian .pol-explain-k { color: #6C4BD9; }

.pol-legend {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 22rpx;
}

.lg-zheng { color: #2E8C63; }

.lg-pian { color: #6C4BD9; }

/* 心性构成 */
.comp {
  margin-top: 18rpx;
  padding: 28rpx 30rpx 12rpx;
}

.comp-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.comp-t {
  font-size: 30rpx;
  font-weight: 700;
}

.comp-sub {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.comp-tip {
  margin: 12rpx 0 6rpx;
  padding: 16rpx 20rpx;
  background: var(--fill);
  border-radius: 14rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

/* 滑标轴 */
.slider-row {
  display: flex;
  align-items: center;
  margin: 10rpx 0 6rpx;
  gap: 12rpx;
}

.sl-lbl {
  font-size: 20rpx;
  flex-shrink: 0;
  max-width: 160rpx;
}

.sl-lbl-l { color: var(--primary); text-align: right; }

.sl-lbl-r { color: #2C6BB0; text-align: left; }

.sl-track {
  flex: 1;
  height: 10rpx;
  background: var(--fill);
  border-radius: 100rpx;
  position: relative;
}

/* 中点刻度：偏离中线多少一眼可见 */
.sl-track::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 2rpx;
  height: 18rpx;
  background: rgba(20, 21, 60, 0.22);
  border-radius: 2rpx;
}

.sl-thumb {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--primary);
  box-shadow: 0 2rpx 8rpx rgba(138, 43, 39, 0.4);
  transition: left 0.4s ease;
}

/* 气泡星团图例（颜色只表达词性，与 traitcluster 组件保持一致） */
.tc-legend {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin: 2rpx 0 6rpx;
}

.tcl {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: var(--ink-3);
}

.tcl::before {
  content: '';
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.tcl-pro::before { background: #F7DCD9; border: 1rpx solid #E6A89F; }

.tcl-neu::before { background: #F3E8C9; border: 1rpx solid #D8C38E; }

.tcl-con::before { background: #DCE8F7; border: 1rpx solid #9CBEE6; }

.tcl-year::before {
  background: #fff;
  border: 2rpx solid #99958E;
  border-radius: 4rpx;
  box-shadow: none;
}

.pc {
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--ink-3);
  margin-top: 4rpx;
}

.pc-on {
  color: var(--ink-2);
}

/* 力量 / 留意：留意另起一段 */
.pc-con {
  margin-top: 12rpx;
}

.pc-key {
  display: inline-block;
  margin-right: 10rpx;
  padding: 1rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  vertical-align: 1rpx;
}

.pc-key-pro {
  color: var(--primary, #8A2B27);
  background: var(--primary-soft, rgba(138, 43, 39, 0.10));
}

.pc-key-con {
  color: #2C6BB0;
  background: rgba(44, 107, 176, 0.10);
}

.comp-empty {
  padding: 30rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}

.acc-card {
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: var(--card);
  box-shadow: var(--shadow);
  border: 1rpx solid var(--line);
}

/* 卡头大运干支：两字竖排小牌 */
.acc-gz {
  flex: none;
  width: 60rpx;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  margin-right: 20rpx;
  background: var(--fill);
  border: 1rpx solid var(--line);
}

.acc-gz-c {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.12;
}

.acc-age {
  flex: none;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  color: #6F5A3B;
  background: rgba(201, 162, 39, 0.10);
  border: 1rpx solid rgba(201, 162, 39, 0.24);
  padding: 6rpx 12rpx;
  border-radius: 100rpx;
}

.wx-muted {
  color: var(--ink-3);
}

.acc-body {
  padding: 24rpx 26rpx 26rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.80), rgba(255, 255, 255, 0.52));
}

.layer-card {
  margin-top: 18rpx;
  padding: 24rpx 0 8rpx;
  border-top: 1rpx solid var(--line);
}

.luck-timeline {
  margin-top: 18rpx;
  padding: 18rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: var(--shadow);
}

.elder-period-nav {
  min-height: 128rpx;
  margin-top: 20rpx;
  padding: 14rpx;
  display: grid;
  grid-template-columns: 1fr 1.12fr 1fr;
  align-items: stretch;
  gap: 10rpx;
  border: 2rpx solid rgba(138, 43, 39, 0.24);
  border-radius: 18rpx;
  background: #fff;
  box-shadow: var(--shadow);
}

.elder-period-btn {
  min-width: 0;
  min-height: 98rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--primary);
  background: var(--tint);
  border: 1rpx solid rgba(138, 43, 39, 0.20);
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.elder-period-btn.disabled {
  color: var(--ink-3);
  background: var(--fill);
  border-color: var(--line);
  opacity: 0.62;
}

.elder-period-arrow {
  font-size: 42rpx;
  line-height: 1;
}

.elder-period-current {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: var(--primary);
  border-radius: 12rpx;
  text-align: center;
}

.elder-period-age {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.elder-period-caption {
  margin-top: 5rpx;
  max-width: 100%;
  font-size: 22rpx;
  font-weight: 700;
  opacity: 0.88;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.luck-detail {
  margin-top: 18rpx;
}

.luck-year.current:not(.on) {
  border-color: rgba(138, 43, 39, 0.42);
}

.luck-current {
  display: block;
  width: 52rpx;
  margin: 6rpx auto 0;
  padding: 2rpx 0;
  border-radius: 100rpx;
  color: #fff;
  background: var(--primary);
  font-size: 17rpx;
  font-weight: 700;
  line-height: 1.35;
}

.time-missing {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-left: 5rpx solid #C9A227;
  color: #78623A;
  background: rgba(243, 232, 201, 0.62);
  font-size: 22rpx;
  line-height: 1.55;
}

.qian-empty {
  padding: 36rpx 20rpx;
  color: var(--ink-3);
  text-align: center;
  font-size: 24rpx;
}

.luck-layer {
  background: transparent;
}

.layer-card:first-of-type {
  margin-top: 0;
}

.layer-body {
  padding-top: 2rpx;
}

.year-insight {
  display: flex;
  align-items: stretch;
  gap: 10rpx;
  margin: 14rpx 0 8rpx;
  padding: 16rpx 10rpx 16rpx 16rpx;
  border-left: 5rpx solid #C59A3B;
  background: rgba(201, 162, 39, 0.09);
}

.year-insight-copy {
  flex: 1;
  min-width: 0;
  align-self: center;
}

.year-insight-k {
  color: #9A6B12;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.55;
  margin-right: 12rpx;
}

.year-insight-t {
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.55;
}

.year-insight-cat-wrap {
  flex: none;
  width: 194rpx;
  min-height: 190rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.year-insight-cat {
  width: 190rpx;
  height: 190rpx;
  display: block;
}

.dual-axis {
  margin: 12rpx 0 4rpx;
  padding: 0 4rpx;
  border-top: 1rpx solid var(--line);
}

.axis-block {
  padding: 12rpx 0 10rpx;
  border-bottom: 1rpx solid rgba(20, 21, 60, 0.08);
}

.axis-block:last-child {
  border-bottom: none;
}

.axis-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
}

.axis-name {
  min-width: 0;
  font-size: 25rpx;
  font-weight: 800;
  color: var(--ink);
}

.axis-energy {
  flex: none;
  font-size: 20rpx;
  color: var(--ink-3);
}

.axis-reason {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 19rpx;
  line-height: 1.45;
}

.trait-source {
  padding: 18rpx 0 8rpx;
  border-top: 1rpx solid var(--line);
}

.layer-notes {
  padding-top: 0;
}

.trait-source-title {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--ink);
}

.luck-controls {
  padding: 14rpx;
  border-radius: 14rpx;
  background: rgba(246, 243, 236, 0.78);
  border: 1rpx solid var(--line);
}

.luck-control-head {
  min-height: 48rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.luck-control-title {
  font-size: 20rpx;
  font-weight: 800;
  color: var(--ink-2);
  white-space: nowrap;
}

.luck-step {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.luck-step-btn {
  flex: none;
  width: 46rpx;
  height: 46rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9A6B12;
  background: rgba(201, 162, 39, 0.14);
  border: 1rpx solid rgba(201, 162, 39, 0.28);
  font-size: 32rpx;
  line-height: 1;
}

.luck-year-main {
  min-width: 0;
  flex: 1;
  text-align: center;
  height: 46rpx;
  line-height: 46rpx;
  border-radius: 10rpx;
  color: #9A6B12;
  background: rgba(201, 162, 39, 0.12);
  border: 1rpx solid rgba(201, 162, 39, 0.28);
  font-size: 23rpx;
  font-weight: 800;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 未叠加流年态：淡灰占位 */
.luck-year-off {
  color: var(--ink-3);
  background: var(--fill);
  border-color: var(--line);
  font-weight: 600;
}

.luck-year-scroll {
  white-space: nowrap;
}

.luck-year-strip {
  display: inline-flex;
  gap: 12rpx;
}

.luck-year {
  width: 136rpx;
  min-height: 86rpx;
  padding: 12rpx 0;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  text-align: center;
}

.luck-year.on {
  background: rgba(201, 162, 39, 0.14);
  border-color: #C9A227;
  box-shadow: inset 0 -4rpx 0 rgba(201, 162, 39, 0.58);
}

.luck-controls .luck-year-strip {
  gap: 8rpx;
}

.luck-controls .luck-year {
  width: 116rpx;
  min-height: 66rpx;
  padding: 7rpx 0 6rpx;
  border-radius: 10rpx;
}

.luck-controls .luck-y {
  font-size: 22rpx;
}

.luck-controls .luck-a {
  margin-top: 0;
  font-size: 18rpx;
}

.luck-period {
  width: 146rpx;
}

.luck-y {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--ink);
}

.luck-a {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

/* 心结与张力（刑冲合害） */
.rel {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.rel:last-child {
  border-bottom: none;
}

.rel-head-line {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.rel-badge {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rel-he { background: #5BD08A; }

.rel-chong { background: #FF4D4D; }

.rel-xing { background: #B47BF0; }

.rel-hai { background: #FF7A33; }

.rel-tag {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--ink-2);
}

.luck-period-summary {
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #8A641B;
  font-weight: 700;
}

.rel-tag-main {
  margin-left: 0;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 800;
}

.rel-luck {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 18rpx;
  color: var(--primary);
  background: var(--tint);
  padding: 3rpx 14rpx;
  border-radius: 100rpx;
}

.rel-zhis-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.rel-zhis {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ink);
}

.rel-zhis-luck {
  font-size: 18rpx;
  color: var(--primary);
  font-weight: 400;
  letter-spacing: 0;
}

.foot {
  margin-top: 36rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

/* 字号档位 */
.fs-l .core-text, .fs-l .pc { font-size: 26rpx; }

/* 长辈模式（特大字）：全部正文/标签统一为一个字号，用加粗代替字号层级，
   避免有的字特大、有的字还是原来的小字，看起来乱。
   结构性单字徽标（日主印章、阶段序号、阶段圈号、刑冲合害圆标、
   加减号、翻页箭头）不在此列，保持原有尺寸以免撑坏固定容器。 */
.fs-xl .core-title, .fs-xl .core-text, .fs-xl .life-title, .fs-xl .life-note, .fs-xl .time-missing, .fs-xl .pattern-badge, .fs-xl .pattern-k, .fs-xl .pattern-t, .fs-xl .pol-t, .fs-xl .pol-sub, .fs-xl .pol-zheng, .fs-xl .pol-pian, .fs-xl .pol-verdict, .fs-xl .pol-explain-k, .fs-xl .pol-explain-t, .fs-xl .pol-legend, .fs-xl .comp-t, .fs-xl .comp-sub, .fs-xl .comp-tip, .fs-xl .sl-lbl, .fs-xl .tcl, .fs-xl .pc, .fs-xl .pc-key, .fs-xl .comp-empty, .fs-xl .acc-gz-c, .fs-xl .acc-age, .fs-xl .year-insight-k, .fs-xl .year-insight-t, .fs-xl .axis-name, .fs-xl .axis-energy, .fs-xl .axis-reason, .fs-xl .luck-control-title, .fs-xl .luck-year-main, .fs-xl .luck-y, .fs-xl .luck-a, .fs-xl .rel-tag, .fs-xl .rel-luck, .fs-xl .rel-zhis, .fs-xl .rel-zhis-luck, .fs-xl .foot {
  font-size: 30rpx;
  font-weight: 700;
}

/* 固定宽度的小容器随统一字号适度放宽，避免挤压 */
.fs-xl .luck-year { width: 140rpx; }

.fs-l .luck-desc { font-size: 27rpx; }

.fs-xl .axis-name, .fs-xl .axis-energy, .fs-xl .trait-source-title {
  font-size: 30rpx;
  font-weight: 700;
}

.fs-xl .life-title {
  font-size: 38rpx;
}

