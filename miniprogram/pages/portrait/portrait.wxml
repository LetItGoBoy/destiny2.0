<template name="traitLayerCard">
  <view class="layer-card luck-layer">
    <view class="year-insight" wx:if="{{layer.yearCard && layer.yearCard.desc}}">
      <view class="year-insight-copy">
        <text class="year-insight-k">{{layer.yearCard.name}}</text>
        <text class="year-insight-t">{{layer.yearCard.desc}}</text>
      </view>
      <view class="year-insight-cat-wrap" wx:if="{{layer.yearCard.catImage}}">
        <image class="year-insight-cat" src="{{layer.yearCard.catImage}}" mode="aspectFit" />
      </view>
    </view>
    <view class="layer-body">
      <traitcluster wx:if="{{layer.bubbles.length}}" bubbles="{{layer.bubbles}}" refresh-key="{{layer.clusterKey}}" />
      <view class="tc-legend" wx:if="{{layer.bubbles.length}}">
        <text class="tcl tcl-pro">力量</text>
        <text class="tcl tcl-neu">本色</text>
        <text class="tcl tcl-con">留意</text>
        <text class="tcl tcl-year" wx:if="{{layer.luckName}}">所选年份</text>
      </view>
    </view>
    <view class="dual-axis" wx:if="{{layer.ganAxis.visible || layer.zhiAxis.visible}}">
      <view class="axis-block" wx:if="{{layer.ganAxis.visible}}">
        <view class="axis-head">
          <text class="axis-name serif">{{layer.ganAxis.name}}</text>
          <text class="axis-energy">影响程度 {{layer.ganAxis.share}}%</text>
        </view>
        <view class="slider-row">
          <text class="sl-lbl sl-lbl-l">{{layer.ganAxis.lbl}}</text>
          <view class="sl-track"><view class="sl-thumb" style="left:{{layer.ganAxis.slider}}%"></view></view>
          <text class="sl-lbl sl-lbl-r">{{layer.ganAxis.rbl}}</text>
        </view>
      </view>
      <view class="axis-block" wx:if="{{layer.zhiAxis.visible}}">
        <view class="axis-head">
          <text class="axis-name serif">{{layer.zhiAxis.name}}</text>
          <text class="axis-energy">影响程度 {{layer.zhiAxis.share}}%</text>
        </view>
        <view class="slider-row">
          <text class="sl-lbl sl-lbl-l">{{layer.zhiAxis.lbl}}</text>
          <view class="sl-track"><view class="sl-thumb" style="left:{{layer.zhiAxis.slider}}%"></view></view>
          <text class="sl-lbl sl-lbl-r">{{layer.zhiAxis.rbl}}</text>
        </view>
      </view>
    </view>
    <view class="layer-body layer-notes" wx:if="{{layer.notes.length}}">
      <view class="trait-source" wx:for="{{layer.notes}}" wx:key="key">
        <view class="trait-source-title serif">{{item.label}}</view>
        <view class="pc pc-on"><text class="pc-key pc-key-pro">{{item.descLabel}}</text>{{item.desc}}</view>
        <view class="pc pc-on pc-con" wx:if="{{item.con}}"><text class="pc-key pc-key-con">{{item.conLabel}}</text>{{item.con}}</view>
      </view>
    </view>
  </view>
</template>

<view class="page fs-{{fs}}" wx:if="{{loaded}}">
  <image class="page-bg" src="/images/home-mystic-bg.jpg" mode="aspectFill" />

  <view class="card core">
    <view class="core-seal serif">{{core.gan}}</view>
    <view class="core-body">
      <view class="core-title serif">{{core.title}}</view>
      <view class="core-text">{{core.text}}</view>
    </view>
  </view>

  <view class="card pattern" wx:if="{{traitPattern}}">
    <view class="pattern-badge serif">性格组合</view>
    <view class="pattern-body">
      <view class="pattern-t">{{traitPattern.note}}</view>
    </view>
  </view>

  <view class="card pol">
    <view class="pol-head">
      <text class="pol-t serif">两种底色</text>
      <text class="pol-sub">守正与求变的配比</text>
    </view>
    <view class="pol-bar">
      <view class="pol-zheng" style="width:{{zhengNow}}%"><text wx:if="{{zhengNow >= 14}}">{{zhengNow}}%</text></view>
      <view class="pol-pian" style="width:{{pianNow}}%"><text wx:if="{{pianNow >= 14}}">{{pianNow}}%</text></view>
    </view>
    <view class="pol-verdict" wx:if="{{polVerdict}}">{{polVerdict}}</view>
    <view class="pol-explain">
      <view class="pol-explain-item pol-explain-zheng">
        <text class="pol-explain-k">守正</text>
        <text class="pol-explain-t">更看重稳定、规则、责任和长期积累，顺的时候可靠踏实。</text>
      </view>
      <view class="pol-explain-item pol-explain-pian">
        <text class="pol-explain-k">求变</text>
        <text class="pol-explain-t">更看重自由、突破、表达和机会变化，顺的时候灵活有冲劲。</text>
      </view>
    </view>
    <view class="pol-legend">
      <text class="lg-zheng">守正 · 稳健循环</text>
      <text class="lg-pian">求变 · 突破不拘</text>
    </view>
  </view>

  <view class="life-lead">
    <view class="life-title serif">不同年龄的你</view>
    <view class="life-note">人的性格会随着经历呈现出不同侧面。选择一个年龄段，看看那时的你更容易怎样想、怎样回应外界。</view>
    <view class="time-missing" wx:if="{{!hasTime}}">出生时间未填写，部分性格细节可能不完整。</view>
  </view>

  <view class="elder-period-nav" wx:if="{{fs === 'xl' && luckPortrait}}">
    <view class="elder-period-btn {{hasPrevLuck ? '' : 'disabled'}}" bindtap="stepLuck" data-d="-1"><text class="elder-period-arrow">‹</text><text>上一段</text></view>
    <view class="elder-period-current">
      <text class="elder-period-age">{{luckPortrait.luckLabel}}</text>
      <text class="elder-period-caption">{{luckPortrait.summary}}</text>
    </view>
    <view class="elder-period-btn {{hasNextLuck ? '' : 'disabled'}}" bindtap="stepLuck" data-d="1"><text>下一段</text><text class="elder-period-arrow">›</text></view>
  </view>

  <view class="luck-timeline" wx:else>
    <scroll-view class="luck-year-scroll" scroll-x show-scrollbar="{{false}}" scroll-into-view="luck{{selectedLuckIndex}}" scroll-with-animation>
      <view class="luck-year-strip">
        <view class="luck-year luck-period {{item.active ? 'on' : ''}} {{item.current ? 'current' : ''}}"
          id="luck{{item.index}}" wx:for="{{luckSegments}}" wx:key="index"
          bindtap="selectLuck" data-index="{{item.index}}">
          <text class="luck-y">{{item.label}}</text>
          <text class="luck-a luck-period-summary" wx:if="{{item.summary}}">{{item.summary}}</text>
          <text class="luck-current" wx:if="{{item.current}}">当前</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="acc-card luck-detail" wx:if="{{luckPortrait}}">
    <view class="acc-body">
      <view class="qian-empty" wx:if="{{luckPortrait.qian}}">这个年龄段暂不展示相关内容。</view>

      <view class="luck-controls" wx:if="{{!luckPortrait.qian && openYearList.length}}">
        <view class="luck-control-head">
          <view class="luck-control-title">具体年份</view>
          <view class="luck-step">
            <view class="luck-step-btn" bindtap="stepYear" data-d="-1">‹</view>
            <view class="luck-year-main {{selectedYear ? '' : 'luck-year-off'}}">{{selectedYear ? selectedYear + '年' : '未选择'}}</view>
            <view class="luck-step-btn" bindtap="stepYear" data-d="1">›</view>
          </view>
        </view>
        <scroll-view class="luck-year-scroll" scroll-x show-scrollbar="{{false}}" scroll-into-view="year{{selectedYear}}" scroll-with-animation>
          <view class="luck-year-strip">
            <view class="luck-year {{item.active ? 'on' : ''}}" id="year{{item.year}}"
              wx:for="{{openYearList}}" wx:key="year" bindtap="selectYear" data-year="{{item.year}}">
              <text class="luck-y">{{item.year}}</text>
              <text class="luck-a">{{item.age}}岁</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <template wx:if="{{luckPortrait.traitLayer}}" is="traitLayerCard" data="{{layer: luckPortrait.traitLayer}}" />
    </view>
  </view>

  <view class="card comp" wx:if="{{relations.length}}">
    <view class="comp-head">
      <text class="comp-t serif">心结与张力</text>
      <text class="comp-sub">成长经历与所选年份带来的牵动</text>
    </view>
    <view class="comp-tip">有些组合会让内心更容易被牵动：可能是放不下的牵挂，也可能是冲突、拉扯或压力。</view>
    <view class="rel" wx:for="{{relations}}" wx:key="type">
      <view class="rel-head-line">
        <text class="rel-tag rel-tag-main">{{item.tag}}</text>
        <text class="rel-luck" wx:if="{{item.anyLuck}}">当前更明显</text>
      </view>
      <view class="pc pc-on">{{item.text}}</view>
    </view>
  </view>

  <view class="foot">性格画像基于出生信息的结构化分析，仅供娱乐参考</view>
</view>
