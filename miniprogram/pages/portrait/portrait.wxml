<view class="page fs-{{fs}}" wx:if="{{loaded}}">
  <image class="page-bg" src="/images/home-mystic-bg.jpg" mode="aspectFill" />

  <view class="card pan">
    <view class="pan-col {{item.isDay ? 'pan-day' : ''}}" wx:for="{{paimian}}" wx:key="label">
      <view class="pan-label">{{item.label}}</view>
      <block wx:if="{{item.empty}}">
        <view class="pan-god dim">-</view>
        <view class="pan-gz serif dim">未知</view>
      </block>
      <block wx:else>
        <view class="pan-god">{{item.god}}</view>
        <view class="pan-gz serif">
          <text class="wx-{{item.ganCls}}">{{item.gan}}</text>
          <text class="wx-{{item.zhiCls}}">{{item.zhi}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="card core">
    <view class="core-seal bg-{{core.cls}} serif">{{core.gan}}</view>
    <view class="core-body">
      <view class="core-title serif">{{core.title}}</view>
      <view class="core-text">{{core.text}}</view>
    </view>
  </view>

  <view class="intro">
    心性画像按人生阶段展开。点开一个阶段，就能看到这一阶段的外显状态和内心反应；再点同一项会收起，点另一个阶段会切换展开。红色泡泡是顺的一面，蓝色泡泡是偏的一面，金色泡泡只出现在「岁运」里。
    <text wx:if="{{!hasTime}}" class="intro-note">（未填出生时辰，晚年阶段的固定底色暂不可见）</text>
  </view>

  <view class="card pol">
    <view class="pol-head">
      <text class="pol-t serif">两种底色</text>
      <text class="pol-sub">守正与求变的配比</text>
    </view>
    <view class="pol-bar">
      <view class="pol-zheng" style="width:{{zhengNow}}%"></view>
      <view class="pol-pian" style="width:{{pianNow}}%"></view>
    </view>
    <view class="pol-explain">
      <view class="pol-explain-item pol-explain-zheng">
        <text class="pol-explain-k">守正</text>
        <text class="pol-explain-t">更看重稳定、规则、责任和长期积累，顺的时候可靠踏实。</text>
      </view>
      <view class="pol-explain-item pol-explain-pian">
        <text class="pol-explain-k">求变</text>
        <text class="pol-explain-t">更看重自由、突破、表达和机会变化，顺的时候灵活有冲劲。</text>
      </view>
    </view>
    <view class="pol-legend">
      <text class="lg-zheng">守正 · 稳健循环</text>
      <text class="lg-pian">求变 · 突破不拘</text>
    </view>
  </view>

  <view class="stage-acc">
    <view class="acc-card {{openStageKey === stage.key ? 'open' : ''}}" wx:for="{{stagePortraits}}" wx:for-item="stage" wx:key="key">
      <view class="acc-head" bindtap="toggleStage" data-key="{{stage.key}}">
        <view class="acc-index">{{stage.index}}</view>
        <view class="acc-copy">
          <view class="acc-title">
            <text class="acc-name serif">{{stage.label}}</text>
            <text class="acc-age">{{stage.age}}</text>
            <text class="acc-sub">{{stage.sub}}</text>
          </view>
          <view class="acc-stage-meta">
            <text class="acc-phase">{{stage.phase}}</text>
            <text class="acc-theme">{{stage.theme}}</text>
          </view>
        </view>
        <view class="acc-action">
          <text class="acc-action-text">{{openStageKey === stage.key ? '收起' : '点开查看'}}</text>
          <view class="acc-arrow">⌄</view>
        </view>
      </view>

      <view class="acc-body" wx:if="{{openStageKey === stage.key}}">
        <view class="stage-note">{{stage.note}}</view>
        <block wx:if="{{stage.empty}}">
          <view class="comp-empty">这一阶段需要出生时辰，当前暂不可见。</view>
        </block>
        <block wx:else>
          <view class="layer-card" wx:if="{{stage.outer}}">
            <view class="layer-head" bindtap="toggleLayer" data-stage="{{stage.key}}" data-layer="outer">
              <view>
                <view class="layer-k layer-k-outer">{{stage.outer.title}}</view>
                <view class="layer-help layer-help-outer">别人更容易看见的表达方式、做事姿态和面对外界时的第一反应。</view>
                <view class="trait-line">
                  <text class="trait-name serif">{{stage.outer.name}}</text>
                  <text class="trait-main" wx:if="{{stage.outer.luckName}}">{{stage.outer.luckName}}</text>
                </view>
              </view>
              <text class="trait-tag tag-{{stage.outer.pol === '正' ? 'z' : 'p'}}" wx:if="{{stage.outer.pol}}">{{stage.outer.pol === '正' ? '守正' : '求变'}}</text>
              <text class="layer-arrow">{{stage.outer.open ? '⌃' : '⌄'}}</text>
            </view>
            <view class="layer-body" wx:if="{{stage.outer.open}}">
              <view class="slider-row {{stage.outer.isFlowOnly ? 'flow-slider' : ''}}">
                <text class="sl-lbl sl-lbl-l">{{stage.outer.lbl}}</text>
                <view class="sl-track">
                  <view class="sl-thumb" style="left:{{stage.outer.slider}}%"></view>
                </view>
                <text class="sl-lbl sl-lbl-r">{{stage.outer.rbl}}</text>
              </view>
              <view class="slider-row flow-slider" wx:if="{{stage.outer.luckName}}">
                <text class="sl-lbl sl-lbl-l">{{stage.outer.luckLbl}}</text>
                <view class="sl-track">
                  <view class="sl-thumb luck-thumb" style="left:{{stage.outer.luckSlider}}%"></view>
                </view>
                <text class="sl-lbl sl-lbl-r">{{stage.outer.luckRbl}}</text>
              </view>
              <traitcluster wx:if="{{stage.outer.bubbles.length}}" bubbles="{{stage.outer.bubbles}}" />
              <view class="trait-pc">
                <view class="pc pc-on"><text class="pc-key pc-key-pro">{{stage.outer.descLabel}}</text>{{stage.outer.desc}}</view>
                <view class="pc pc-on pc-con" wx:if="{{stage.outer.con}}"><text class="pc-key pc-key-con">{{stage.outer.conLabel}}</text>{{stage.outer.con}}</view>
              </view>
            </view>
          </view>

          <view class="layer-card" wx:if="{{stage.inner}}">
            <view class="layer-head" bindtap="toggleLayer" data-stage="{{stage.key}}" data-layer="inner">
              <view>
                <view class="layer-k layer-k-inner">{{stage.inner.title}}</view>
                <view class="layer-help layer-help-inner">更靠里的情绪底色、安全感来源和关系里的真实反应，不一定立刻表现出来。</view>
                <view class="trait-line">
                  <text class="trait-name serif">{{stage.inner.name}}</text>
                  <text class="trait-main" wx:if="{{stage.inner.luckName}}">{{stage.inner.luckName}}</text>
                </view>
              </view>
              <text class="trait-tag tag-{{stage.inner.pol === '正' ? 'z' : 'p'}}" wx:if="{{stage.inner.pol}}">{{stage.inner.pol === '正' ? '守正' : '求变'}}</text>
              <text class="layer-arrow">{{stage.inner.open ? '⌃' : '⌄'}}</text>
            </view>
            <view class="layer-body" wx:if="{{stage.inner.open}}">
              <view class="slider-row">
                <text class="sl-lbl sl-lbl-l">{{stage.inner.lbl}}</text>
                <view class="sl-track">
                  <view class="sl-thumb" style="left:{{stage.inner.slider}}%"></view>
                </view>
                <text class="sl-lbl sl-lbl-r">{{stage.inner.rbl}}</text>
              </view>
              <view class="slider-row flow-slider" wx:if="{{stage.inner.luckName}}">
                <text class="sl-lbl sl-lbl-l">{{stage.inner.luckLbl}}</text>
                <view class="sl-track">
                  <view class="sl-thumb luck-thumb" style="left:{{stage.inner.luckSlider}}%"></view>
                </view>
                <text class="sl-lbl sl-lbl-r">{{stage.inner.luckRbl}}</text>
              </view>
              <traitcluster wx:if="{{stage.inner.bubbles.length}}" bubbles="{{stage.inner.bubbles}}" />
              <view class="trait-pc">
                <view class="pc pc-on"><text class="pc-key pc-key-pro">{{stage.inner.descLabel}}</text>{{stage.inner.desc}}</view>
                <view class="pc pc-on pc-con" wx:if="{{stage.inner.con}}"><text class="pc-key pc-key-con">{{stage.inner.conLabel}}</text>{{stage.inner.con}}</view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="acc-card luck-card {{openStageKey === 'luck' ? 'open' : ''}}">
      <view class="acc-head" bindtap="toggleStage" data-key="luck">
        <view class="acc-index luck-index">流</view>
        <view class="acc-copy">
          <view class="acc-title">
            <text class="acc-name serif">岁运</text>
            <text class="acc-sub">流动心性</text>
          </view>
          <view class="acc-pills">
            <text class="acc-pill luck-pill">选择阶段</text>
            <text class="acc-pill luck-pill">选择年份</text>
            <text class="acc-pill luck-pill">金色泡泡混入</text>
          </view>
        </view>
        <view class="acc-action">
          <text class="acc-action-text">{{openStageKey === 'luck' ? '收起' : '点开查看'}}</text>
          <view class="acc-arrow">⌄</view>
        </view>
      </view>

      <view class="acc-body" wx:if="{{openStageKey === 'luck'}}">
        <view class="stage-note">先选择要叠加到哪个人生阶段，再选择该阶段对应的年份。金色泡泡会直接混进这一阶段的外显和内心星团里。</view>

        <view class="luck-controls">
          <view class="luck-control-title">选择阶段</view>
          <view class="luck-stage-row">
            <view class="luck-stage {{luckStageIndex === idx ? 'on' : ''}}" wx:for="{{stagePortraits}}" wx:for-item="st" wx:for-index="idx" wx:key="key" bindtap="selectLuckStage" data-index="{{idx}}">
              <text>{{st.label}}</text>
            </view>
          </view>
        </view>

        <view class="luck-controls">
          <view class="luck-control-title">选择年份</view>
          <block wx:if="{{luckYearList.length}}">
            <view class="luck-step">
              <view class="luck-step-btn" bindtap="stepLuckYear" data-d="-1">‹</view>
              <view class="luck-year-main">{{luckYear}}</view>
              <view class="luck-step-btn" bindtap="stepLuckYear" data-d="1">›</view>
            </view>
            <scroll-view class="luck-year-scroll" scroll-x enhanced show-scrollbar="{{false}}">
              <view class="luck-year-strip">
                <view class="luck-year {{item.active ? 'on' : ''}}" wx:for="{{luckYearList}}" wx:key="year" bindtap="selectLuckYear" data-year="{{item.year}}">
                  <text class="luck-y">{{item.year}}</text>
                  <text class="luck-a">{{item.age}}岁</text>
                </view>
              </view>
            </scroll-view>
          </block>
          <view class="comp-empty" wx:else>这个阶段暂无可选年份。</view>
        </view>

        <view class="luck-block" wx:if="{{luckFlow}}">
          <view class="luck-head">
            <text class="luck-badge">{{luckYear}}心性</text>
            <text class="luck-name serif">{{luckFlow.name}}</text>
            <text class="luck-lbls" wx:if="{{luckFlow.lbl}}">{{luckFlow.lbl}} · {{luckFlow.rbl}}</text>
          </view>
          <view class="luck-lead" wx:if="{{luckFlow.lead}}">{{luckFlow.lead}}</view>
          <view class="luck-desc">{{luckFlow.desc}}</view>
        </view>

        <block wx:if="{{luckPortrait && !luckPortrait.empty}}">
          <view class="layer-card" wx:if="{{luckPortrait.outer}}">
            <view class="layer-head" bindtap="toggleLayer" data-stage="luck" data-layer="outer">
              <view>
                <view class="layer-k layer-k-outer">{{luckPortrait.outer.title}}</view>
                <view class="layer-help layer-help-outer">别人更容易看见的表达方式、做事姿态和面对外界时的第一反应。</view>
                <view class="trait-line">
                  <text class="trait-name serif">{{luckPortrait.outer.name}}</text>
                  <text class="trait-main">{{luckPortrait.outer.luckName}}</text>
                </view>
              </view>
              <text class="trait-tag tag-{{luckPortrait.outer.pol === '正' ? 'z' : 'p'}}" wx:if="{{luckPortrait.outer.pol}}">{{luckPortrait.outer.pol === '正' ? '守正' : '求变'}}</text>
              <text class="layer-arrow">{{luckPortrait.outer.open ? '⌃' : '⌄'}}</text>
            </view>
            <view class="layer-body" wx:if="{{luckPortrait.outer.open}}">
              <view class="slider-row {{luckPortrait.outer.isFlowOnly ? 'flow-slider' : ''}}">
                <text class="sl-lbl sl-lbl-l">{{luckPortrait.outer.lbl}}</text>
                <view class="sl-track">
                  <view class="sl-thumb" style="left:{{luckPortrait.outer.slider}}%"></view>
                </view>
                <text class="sl-lbl sl-lbl-r">{{luckPortrait.outer.rbl}}</text>
              </view>
              <view class="slider-row flow-slider" wx:if="{{luckPortrait.outer.luckName}}">
                <text class="sl-lbl sl-lbl-l">{{luckPortrait.outer.luckLbl}}</text>
                <view class="sl-track">
                  <view class="sl-thumb luck-thumb" style="left:{{luckPortrait.outer.luckSlider}}%"></view>
                </view>
                <text class="sl-lbl sl-lbl-r">{{luckPortrait.outer.luckRbl}}</text>
              </view>
              <traitcluster wx:if="{{luckPortrait.outer.bubbles.length}}" bubbles="{{luckPortrait.outer.bubbles}}" />
              <view class="trait-pc">
                <view class="pc pc-on"><text class="pc-key pc-key-pro">{{luckPortrait.outer.descLabel}}</text>{{luckPortrait.outer.desc}}</view>
                <view class="pc pc-on pc-con" wx:if="{{luckPortrait.outer.con}}"><text class="pc-key pc-key-con">{{luckPortrait.outer.conLabel}}</text>{{luckPortrait.outer.con}}</view>
              </view>
            </view>
          </view>

          <view class="layer-card" wx:if="{{luckPortrait.inner}}">
            <view class="layer-head" bindtap="toggleLayer" data-stage="luck" data-layer="inner">
              <view>
                <view class="layer-k layer-k-inner">{{luckPortrait.inner.title}}</view>
                <view class="layer-help layer-help-inner">更靠里的情绪底色、安全感来源和关系里的真实反应，不一定立刻表现出来。</view>
                <view class="trait-line">
                  <text class="trait-name serif">{{luckPortrait.inner.name}}</text>
                  <text class="trait-main">{{luckPortrait.inner.luckName}}</text>
                </view>
              </view>
              <text class="trait-tag tag-{{luckPortrait.inner.pol === '正' ? 'z' : 'p'}}" wx:if="{{luckPortrait.inner.pol}}">{{luckPortrait.inner.pol === '正' ? '守正' : '求变'}}</text>
              <text class="layer-arrow">{{luckPortrait.inner.open ? '⌃' : '⌄'}}</text>
            </view>
            <view class="layer-body" wx:if="{{luckPortrait.inner.open}}">
              <view class="slider-row">
                <text class="sl-lbl sl-lbl-l">{{luckPortrait.inner.lbl}}</text>
                <view class="sl-track">
                  <view class="sl-thumb" style="left:{{luckPortrait.inner.slider}}%"></view>
                </view>
                <text class="sl-lbl sl-lbl-r">{{luckPortrait.inner.rbl}}</text>
              </view>
              <view class="slider-row flow-slider" wx:if="{{luckPortrait.inner.luckName}}">
                <text class="sl-lbl sl-lbl-l">{{luckPortrait.inner.luckLbl}}</text>
                <view class="sl-track">
                  <view class="sl-thumb luck-thumb" style="left:{{luckPortrait.inner.luckSlider}}%"></view>
                </view>
                <text class="sl-lbl sl-lbl-r">{{luckPortrait.inner.luckRbl}}</text>
              </view>
              <traitcluster wx:if="{{luckPortrait.inner.bubbles.length}}" bubbles="{{luckPortrait.inner.bubbles}}" />
              <view class="trait-pc">
                <view class="pc pc-on"><text class="pc-key pc-key-pro">{{luckPortrait.inner.descLabel}}</text>{{luckPortrait.inner.desc}}</view>
                <view class="pc pc-on pc-con" wx:if="{{luckPortrait.inner.con}}"><text class="pc-key pc-key-con">{{luckPortrait.inner.conLabel}}</text>{{luckPortrait.inner.con}}</view>
              </view>
            </view>
          </view>
        </block>
        <view class="comp-empty" wx:if="{{luckPortrait && luckPortrait.empty}}">这一阶段需要出生时辰，当前暂不可见。</view>
      </view>
    </view>
  </view>

  <view class="card comp" wx:if="{{relations.length}}">
    <view class="comp-head">
      <text class="comp-t serif">心结与张力</text>
      <text class="comp-sub">内在的牵动</text>
    </view>
    <view class="comp-tip">有些组合会让内心更容易被牵动：可能是放不下的牵挂，也可能是冲突、拉扯或压力。</view>
    <view class="rel" wx:for="{{relations}}" wx:key="type">
      <view class="rel-head-line">
        <text class="rel-badge rel-{{item.cls}}">{{item.type}}</text>
        <text class="rel-tag">{{item.tag}}</text>
        <text class="rel-luck" wx:if="{{item.anyLuck}}">阶段引动</text>
      </view>
      <view class="rel-zhis-row">
        <text class="rel-zhis serif" wx:for="{{item.items}}" wx:for-item="it" wx:key="zhis">{{it.zhis}}<text wx:if="{{it.luck}}" class="rel-zhis-luck">↑</text>  </text>
      </view>
      <view class="pc pc-on">{{item.text}}</view>
    </view>
  </view>

  <view class="foot">性格画像基于出生信息的结构化分析，仅供娱乐参考</view>
</view>
