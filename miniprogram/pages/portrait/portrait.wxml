<!-- 人前/人后 心性卡：stage 与岁运两处复用（sk 阶段键 / lk outer|inner） -->
<template name="layerCard">
  <view class="layer-card stage-layer">
    <view class="layer-tap" bindtap="toggleLayer" data-stage="{{sk}}" data-layer="{{lk}}">
      <text class="layer-k {{layer.side === 'inner' ? 'layer-k-inner' : ''}}">{{layer.title}}</text>
      <text class="layer-tap-name serif">{{layer.name}}</text>
      <text class="layer-tap-luck" wx:if="{{layer.luckName}}">{{layer.luckName}}</text>
      <text class="layer-arrow {{layer.open ? 'layer-arrow-up' : ''}}">▾</text>
    </view>
    <block wx:if="{{layer.open}}">
      <view class="layer-head">
        <view class="layer-copy">
          <view class="layer-help {{layer.side === 'inner' ? 'layer-help-inner' : ''}}">{{layer.help}}</view>
        </view>
        <view class="trait-cat-wrap" wx:if="{{layer.catImage}}">
          <image class="trait-cat" src="{{layer.catImage}}" mode="aspectFit" />
        </view>
      </view>
      <view class="layer-body">
        <view class="slider-row" wx:if="{{layer.lbl && layer.rbl}}">
          <text class="sl-lbl sl-lbl-l">{{layer.lbl}}</text>
          <view class="sl-track">
            <view class="sl-thumb" style="left:{{layer.slider}}%"></view>
          </view>
          <text class="sl-lbl sl-lbl-r">{{layer.rbl}}</text>
        </view>
        <traitcluster wx:if="{{layer.bubbles.length}}" bubbles="{{layer.bubbles}}" />
        <view class="tc-legend" wx:if="{{layer.bubbles.length}}">
          <text class="tcl tcl-pro">顺的一面</text>
          <text class="tcl tcl-con">偏的一面</text>
          <text class="tcl tcl-luck" wx:if="{{layer.luckName}}">当年激活</text>
        </view>
        <view class="trait-pc">
          <view class="pc pc-on"><text class="pc-key pc-key-pro">{{layer.descLabel}}</text>{{layer.desc}}</view>
          <view class="pc pc-on pc-con" wx:if="{{layer.con}}"><text class="pc-key pc-key-con">{{layer.conLabel}}</text>{{layer.con}}</view>
        </view>
      </view>
    </block>
  </view>
</template>

<view class="page fs-{{fs}}" wx:if="{{loaded}}">
  <image class="page-bg" src="/images/home-mystic-bg.jpg" mode="aspectFill" />

  <view class="card core">
    <view class="core-seal serif">{{core.gan}}</view>
    <view class="core-body">
      <view class="core-title serif">{{core.title}}</view>
      <view class="core-text">{{core.text}}</view>
    </view>
  </view>

  <view class="card pattern" wx:if="{{traitPattern}}">
    <view class="pattern-badge serif">{{traitPattern.name}}</view>
    <view class="pattern-body">
      <view class="pattern-k">命局结构</view>
      <view class="pattern-t">{{traitPattern.note}}</view>
    </view>
  </view>

  <view class="card pol">
    <view class="pol-head">
      <text class="pol-t serif">两种底色</text>
      <text class="pol-sub">守正与求变的配比</text>
    </view>
    <view class="pol-bar">
      <view class="pol-zheng" style="width:{{zhengNow}}%"><text wx:if="{{zhengNow >= 14}}">{{zhengNow}}%</text></view>
      <view class="pol-pian" style="width:{{pianNow}}%"><text wx:if="{{pianNow >= 14}}">{{pianNow}}%</text></view>
    </view>
    <view class="pol-verdict" wx:if="{{polVerdict}}">{{polVerdict}}</view>
    <view class="pol-explain">
      <view class="pol-explain-item pol-explain-zheng">
        <text class="pol-explain-k">守正</text>
        <text class="pol-explain-t">更看重稳定、规则、责任和长期积累，顺的时候可靠踏实。</text>
      </view>
      <view class="pol-explain-item pol-explain-pian">
        <text class="pol-explain-k">求变</text>
        <text class="pol-explain-t">更看重自由、突破、表达和机会变化，顺的时候灵活有冲劲。</text>
      </view>
    </view>
    <view class="pol-legend">
      <text class="lg-zheng">守正 · 稳健循环</text>
      <text class="lg-pian">求变 · 突破不拘</text>
    </view>
  </view>

  <view class="life-lead">
    <view class="life-title serif">四阶段心性</view>
    <view class="life-note">少年、青年、中年、老年各有稳定的心性来源。阶段内切换岁运年龄段查看变化；流年天干只叠加当年的行为表现。</view>
  </view>

  <view class="stage-acc">
    <view class="acc-card {{openStageKey === stage.key ? 'open' : ''}}" wx:for="{{stagePortraits}}" wx:for-item="stage" wx:key="key">
      <view class="acc-head" bindtap="toggleStage" data-key="{{stage.key}}">
        <view class="acc-gz serif">
          <text class="acc-gz-c wx-{{stage.ganCls}}">{{stage.ganText}}</text>
          <text class="acc-gz-c wx-{{stage.zhiCls}}">{{stage.zhiText}}</text>
        </view>
        <view class="acc-copy">
          <view class="acc-title">
            <text class="acc-name serif">{{stage.label}}</text>
            <text class="acc-now" wx:if="{{stage.key === currentStageKey}}">当前</text>
            <text class="acc-age">{{stage.age}}</text>
          </view>
          <view class="acc-trait-line" wx:if="{{!stage.empty}}">
            <text class="acc-side-k">人前</text>
            <text class="acc-trait-name">{{stage.outerLayer.name}}</text>
            <text class="acc-side-k acc-side-in">人后</text>
            <text class="acc-trait-name acc-trait-name-last">{{stage.innerLayer.name}}</text>
          </view>
          <view class="acc-trait-line" wx:else>
            <text class="acc-trait-empty">{{stage.summary}}</text>
          </view>
        </view>
        <view class="acc-action">
          <text class="acc-action-tip">{{openStageKey === stage.key ? '收起' : '查看'}}</text>
          <text class="acc-plus">{{openStageKey === stage.key ? '−' : '+'}}</text>
        </view>
      </view>

      <view class="acc-body" wx:if="{{openStageKey === stage.key}}">
        <view class="stage-note">{{stage.note}}</view>

        <view class="luck-controls" wx:if="{{stage.luckSegments.length}}">
          <view class="luck-control-title">岁运年龄段</view>
          <scroll-view class="luck-year-scroll" scroll-x show-scrollbar="{{false}}">
            <view class="luck-year-strip">
              <view class="luck-year luck-period {{item.active ? 'on' : ''}}"
                wx:for="{{stage.luckSegments}}" wx:key="index" bindtap="selectStageLuck"
                data-key="{{stage.key}}" data-index="{{item.index}}">
                <text class="luck-y">{{item.gz}}</text>
                <text class="luck-a">{{item.label}}</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="luck-controls" wx:if="{{!stage.empty && openYearList.length}}">
          <view class="luck-control-title">叠加流年（可选，再点取消）</view>
          <view class="luck-step">
            <view class="luck-step-btn" bindtap="stepStageYear" data-key="{{stage.key}}" data-d="-1">‹</view>
            <view class="luck-year-main {{stage.hasYear ? '' : 'luck-year-off'}}">{{stage.hasYear ? stage.luckYear : '未叠加'}}</view>
            <view class="luck-step-btn" bindtap="stepStageYear" data-key="{{stage.key}}" data-d="1">›</view>
          </view>
          <scroll-view class="luck-year-scroll" scroll-x show-scrollbar="{{false}}"
            scroll-into-view="y{{stage.luckYear}}" scroll-with-animation>
            <view class="luck-year-strip">
              <view class="luck-year {{item.active ? 'on' : ''}}" id="y{{item.year}}"
                wx:for="{{openYearList}}" wx:key="year" bindtap="selectStageYear" data-key="{{stage.key}}" data-year="{{item.year}}">
                <text class="luck-y">{{item.year}}</text>
                <text class="luck-a">{{item.age}}岁</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <template wx:if="{{stage.outerLayer}}" is="layerCard" data="{{ layer: stage.outerLayer, sk: stage.key, lk: 'outer' }}" />
        <template wx:if="{{stage.innerLayer}}" is="layerCard" data="{{ layer: stage.innerLayer, sk: stage.key, lk: 'inner' }}" />
      </view>
    </view>
  </view>

  <view class="card comp" wx:if="{{relations.length}}">
    <view class="comp-head">
      <text class="comp-t serif">心结与张力</text>
      <text class="comp-sub">内在的牵动</text>
    </view>
    <view class="comp-tip">有些组合会让内心更容易被牵动：可能是放不下的牵挂，也可能是冲突、拉扯或压力。</view>
    <view class="rel" wx:for="{{relations}}" wx:key="type">
      <view class="rel-head-line">
        <text class="rel-badge rel-{{item.cls}}">{{item.type}}</text>
        <text class="rel-tag">{{item.tag}}</text>
        <text class="rel-luck" wx:if="{{item.anyLuck}}">阶段引动</text>
      </view>
      <view class="rel-zhis-row">
        <text class="rel-zhis serif" wx:for="{{item.items}}" wx:for-item="it" wx:key="zhis">{{it.zhis}}<text wx:if="{{it.luck}}" class="rel-zhis-luck">↑</text>  </text>
      </view>
      <view class="pc pc-on">{{item.text}}</view>
    </view>
  </view>

  <view class="foot">性格画像基于出生信息的结构化分析，仅供娱乐参考</view>
</view>
