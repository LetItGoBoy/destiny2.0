<view class="page fs-{{fs}}" wx:if="{{loaded}}">
  <image class="page-bg" src="/images/home-mystic-bg.jpg" mode="aspectFill" />

  <view class="card core">
    <view class="core-seal serif">{{core.gan}}</view>
    <view class="core-body">
      <view class="core-title serif">{{core.title}}</view>
      <view class="core-text">{{core.text}}</view>
    </view>
  </view>

  <view class="card pattern" wx:if="{{traitPattern}}">
    <view class="pattern-badge serif">{{traitPattern.name}}</view>
    <view class="pattern-body">
      <view class="pattern-k">命局结构</view>
      <view class="pattern-t">{{traitPattern.note}}</view>
    </view>
  </view>

  <view class="card pol">
    <view class="pol-head">
      <text class="pol-t serif">两种底色</text>
      <text class="pol-sub">守正与求变的配比</text>
    </view>
    <view class="pol-bar">
      <view class="pol-zheng" style="width:{{zhengNow}}%"><text wx:if="{{zhengNow >= 14}}">{{zhengNow}}%</text></view>
      <view class="pol-pian" style="width:{{pianNow}}%"><text wx:if="{{pianNow >= 14}}">{{pianNow}}%</text></view>
    </view>
    <view class="pol-verdict" wx:if="{{polVerdict}}">{{polVerdict}}</view>
    <view class="pol-explain">
      <view class="pol-explain-item pol-explain-zheng">
        <text class="pol-explain-k">守正</text>
        <text class="pol-explain-t">更看重稳定、规则、责任和长期积累，顺的时候可靠踏实。</text>
      </view>
      <view class="pol-explain-item pol-explain-pian">
        <text class="pol-explain-k">求变</text>
        <text class="pol-explain-t">更看重自由、突破、表达和机会变化，顺的时候灵活有冲劲。</text>
      </view>
    </view>
    <view class="pol-legend">
      <text class="lg-zheng">守正 · 稳健循环</text>
      <text class="lg-pian">求变 · 突破不拘</text>
    </view>
  </view>

  <view class="life-lead">
    <view class="life-title serif">八段人生</view>
  </view>

  <view class="stage-acc">
    <view class="acc-card {{openStageKey === stage.key ? 'open' : ''}}" wx:for="{{stagePortraits}}" wx:for-item="stage" wx:key="key">
      <view class="acc-head" bindtap="toggleStage" data-key="{{stage.key}}">
        <view class="acc-index">{{stage.indexText}}</view>
        <view class="acc-copy">
          <view class="acc-title">
            <text class="acc-name serif">{{stage.label}}</text>
            <text class="acc-now" wx:if="{{stage.key === currentStageKey}}">当前</text>
            <text class="acc-age">{{stage.age}}</text>
            <text class="acc-sub">{{stage.sub}}</text>
          </view>
          <view class="acc-stage-meta">
            <text class="acc-phase">{{stage.phase}}</text>
            <text class="acc-theme">{{stage.theme}}</text>
          </view>
          <view class="acc-trait-line" wx:if="{{!stage.empty && stage.layer}}">
            <text class="acc-trait-name">{{stage.layer.name}}</text>
            <text class="acc-trait-lbl" wx:if="{{stage.layer.lbl}}">{{stage.layer.lbl}} · {{stage.layer.rbl}}</text>
          </view>
          <view class="acc-trait-line" wx:if="{{stage.empty}}">
            <text class="acc-trait-need">需出生时辰后可见</text>
          </view>
        </view>
        <view class="acc-action">
          <text class="acc-action-tip">{{openStageKey === stage.key ? '收起' : '查看'}}</text>
          <text class="acc-plus">{{openStageKey === stage.key ? '−' : '+'}}</text>
        </view>
      </view>

      <view class="acc-body" wx:if="{{openStageKey === stage.key}}">
        <view class="stage-note">{{stage.note}}</view>
        <block wx:if="{{stage.empty}}">
          <view class="comp-empty">这一阶段需要出生时辰，当前暂不可见。</view>
        </block>
        <block wx:elif="{{stage.layer}}">
          <view class="layer-card stage-layer">
            <view class="layer-head">
              <view class="layer-copy">
                <view class="layer-k">{{stage.layer.title}}</view>
                <view class="layer-help">{{stage.layer.help}}</view>
                <view class="trait-line">
                  <text class="trait-name serif">{{stage.layer.name}}</text>
                  <text class="trait-main" wx:if="{{stage.layer.luckName}}">{{stage.layer.luckName}}</text>
                </view>
              </view>
              <view class="trait-cat-wrap" wx:if="{{stage.layer.catImage}}">
                <image class="trait-cat" src="{{stage.layer.catImage}}" mode="aspectFit" />
              </view>
            </view>
            <view class="layer-body">
              <view class="slider-row" wx:if="{{stage.layer.lbl && stage.layer.rbl}}">
                <text class="sl-lbl sl-lbl-l">{{stage.layer.lbl}}</text>
                <view class="sl-track">
                  <view class="sl-thumb" style="left:{{stage.layer.slider}}%"></view>
                </view>
                <text class="sl-lbl sl-lbl-r">{{stage.layer.rbl}}</text>
              </view>
              <view class="slider-row flow-slider" wx:if="{{stage.layer.luckName}}">
                <text class="sl-lbl sl-lbl-l">{{stage.layer.luckLbl}}</text>
                <view class="sl-track">
                  <view class="sl-thumb luck-thumb" style="left:{{stage.layer.luckSlider}}%"></view>
                </view>
                <text class="sl-lbl sl-lbl-r">{{stage.layer.luckRbl}}</text>
              </view>
              <traitcluster wx:if="{{stage.layer.bubbles.length}}" bubbles="{{stage.layer.bubbles}}" />
              <view class="tc-legend" wx:if="{{stage.layer.bubbles.length}}">
                <text class="tcl tcl-pro">顺的一面</text>
                <text class="tcl tcl-con">偏的一面</text>
                <text class="tcl tcl-luck" wx:if="{{stage.layer.luckName}}">当年激活</text>
              </view>
              <view class="trait-pc">
                <view class="pc pc-on"><text class="pc-key pc-key-pro">{{stage.layer.descLabel}}</text>{{stage.layer.desc}}</view>
                <view class="pc pc-on pc-con" wx:if="{{stage.layer.con}}"><text class="pc-key pc-key-con">{{stage.layer.conLabel}}</text>{{stage.layer.con}}</view>
              </view>
            </view>
          </view>
        </block>
        <view class="comp-empty" wx:else>这一阶段暂无可展示的心性信息。</view>
      </view>
    </view>

    <view class="life-lead luck-guide">
      <view class="life-title serif">岁运叠加</view>
      <view class="life-note">选择某一段人生和对应年份，查看这一年把哪种心性推到台前。金色气泡表示临时被激活的状态。</view>
    </view>

    <view class="acc-card luck-card {{openStageKey === 'luck' ? 'open' : ''}}">
      <view class="acc-head" bindtap="toggleStage" data-key="luck">
        <view class="acc-index luck-index">运</view>
        <view class="acc-copy">
          <view class="acc-title">
            <text class="acc-name serif">岁运</text>
            <text class="acc-sub">流动心性</text>
          </view>
          <view class="acc-pills">
            <text class="acc-pill luck-pill">选择阶段</text>
            <text class="acc-pill luck-pill">选择年份</text>
            <text class="acc-pill luck-pill">金色泡泡叠加</text>
          </view>
        </view>
        <view class="acc-action">
          <text class="acc-action-tip">{{openStageKey === 'luck' ? '收起' : '查看'}}</text>
          <text class="acc-plus">{{openStageKey === 'luck' ? '−' : '+'}}</text>
        </view>
      </view>

      <view class="acc-body" wx:if="{{openStageKey === 'luck'}}">
        <view class="stage-note">先选择要叠加的阶段，再选择对应年份。金色泡泡会混进这一阶段的心性星团里，表示当年更容易被激活的状态。</view>

        <view class="luck-controls">
          <view class="luck-control-title">选择阶段</view>
          <view class="luck-stage-row">
            <view class="luck-stage {{luckStageIndex === idx ? 'on' : ''}}" wx:for="{{stagePortraits}}" wx:for-item="st" wx:for-index="idx" wx:key="key" bindtap="selectLuckStage" data-index="{{idx}}">
              <text>{{st.label}}</text>
            </view>
          </view>
        </view>

        <view class="luck-controls">
          <view class="luck-control-title">选择年份</view>
          <block wx:if="{{luckYearList.length}}">
            <view class="luck-step">
              <view class="luck-step-btn" bindtap="stepLuckYear" data-d="-1">‹</view>
              <view class="luck-year-main">{{luckYear}}</view>
              <view class="luck-step-btn" bindtap="stepLuckYear" data-d="1">›</view>
            </view>
            <scroll-view class="luck-year-scroll" scroll-x show-scrollbar="{{false}}"
              scroll-into-view="y{{luckYear}}" scroll-with-animation>
              <view class="luck-year-strip">
                <view class="luck-year {{item.active ? 'on' : ''}}" id="y{{item.year}}"
                  wx:for="{{luckYearList}}" wx:key="year" bindtap="selectLuckYear" data-year="{{item.year}}">
                  <text class="luck-y">{{item.year}}</text>
                  <text class="luck-a">{{item.age}}岁</text>
                </view>
              </view>
            </scroll-view>
          </block>
          <view class="comp-empty" wx:else>这个阶段暂无可选年份。</view>
        </view>

        <view class="luck-block" wx:if="{{luckFlow}}">
          <view class="luck-head">
            <image class="luck-cat" wx:if="{{luckFlow.catImage}}" src="{{luckFlow.catImage}}" mode="aspectFit" />
            <text class="luck-badge">{{luckYear}}心性</text>
            <text class="luck-name serif">{{luckFlow.name}}</text>
            <text class="luck-lbls" wx:if="{{luckFlow.lbl}}">{{luckFlow.lbl}} · {{luckFlow.rbl}}</text>
          </view>
          <view class="luck-lead" wx:if="{{luckFlow.lead}}">{{luckFlow.lead}}</view>
          <view class="luck-desc">{{luckFlow.desc}}</view>
        </view>

        <block wx:if="{{luckPortrait && !luckPortrait.empty && luckPortrait.layer}}">
          <view class="layer-card stage-layer">
            <view class="layer-head">
              <view class="layer-copy">
                <view class="layer-k">{{luckPortrait.layer.title}}</view>
                <view class="layer-help">{{luckPortrait.layer.help}}</view>
                <view class="trait-line">
                  <text class="trait-name serif">{{luckPortrait.layer.name}}</text>
                  <text class="trait-main" wx:if="{{luckPortrait.layer.luckName}}">{{luckPortrait.layer.luckName}}</text>
                </view>
              </view>
              <view class="trait-cat-wrap" wx:if="{{luckPortrait.layer.catImage}}">
                <image class="trait-cat" src="{{luckPortrait.layer.catImage}}" mode="aspectFit" />
              </view>
            </view>
            <view class="layer-body">
              <view class="slider-row" wx:if="{{luckPortrait.layer.lbl && luckPortrait.layer.rbl}}">
                <text class="sl-lbl sl-lbl-l">{{luckPortrait.layer.lbl}}</text>
                <view class="sl-track">
                  <view class="sl-thumb" style="left:{{luckPortrait.layer.slider}}%"></view>
                </view>
                <text class="sl-lbl sl-lbl-r">{{luckPortrait.layer.rbl}}</text>
              </view>
              <view class="slider-row flow-slider" wx:if="{{luckPortrait.layer.luckName}}">
                <text class="sl-lbl sl-lbl-l">{{luckPortrait.layer.luckLbl}}</text>
                <view class="sl-track">
                  <view class="sl-thumb luck-thumb" style="left:{{luckPortrait.layer.luckSlider}}%"></view>
                </view>
                <text class="sl-lbl sl-lbl-r">{{luckPortrait.layer.luckRbl}}</text>
              </view>
              <traitcluster wx:if="{{luckPortrait.layer.bubbles.length}}" bubbles="{{luckPortrait.layer.bubbles}}" />
              <view class="tc-legend" wx:if="{{luckPortrait.layer.bubbles.length}}">
                <text class="tcl tcl-pro">顺的一面</text>
                <text class="tcl tcl-con">偏的一面</text>
                <text class="tcl tcl-luck" wx:if="{{luckPortrait.layer.luckName}}">当年激活</text>
              </view>
              <view class="trait-pc">
                <view class="pc pc-on"><text class="pc-key pc-key-pro">{{luckPortrait.layer.descLabel}}</text>{{luckPortrait.layer.desc}}</view>
                <view class="pc pc-on pc-con" wx:if="{{luckPortrait.layer.con}}"><text class="pc-key pc-key-con">{{luckPortrait.layer.conLabel}}</text>{{luckPortrait.layer.con}}</view>
              </view>
            </view>
          </view>
        </block>
        <view class="comp-empty" wx:if="{{luckPortrait && luckPortrait.empty}}">这一阶段需要出生时辰，当前暂不可见。</view>
      </view>
    </view>
  </view>

  <view class="card comp" wx:if="{{relations.length}}">
    <view class="comp-head">
      <text class="comp-t serif">心结与张力</text>
      <text class="comp-sub">内在的牵动</text>
    </view>
    <view class="comp-tip">有些组合会让内心更容易被牵动：可能是放不下的牵挂，也可能是冲突、拉扯或压力。</view>
    <view class="rel" wx:for="{{relations}}" wx:key="type">
      <view class="rel-head-line">
        <text class="rel-badge rel-{{item.cls}}">{{item.type}}</text>
        <text class="rel-tag">{{item.tag}}</text>
        <text class="rel-luck" wx:if="{{item.anyLuck}}">阶段引动</text>
      </view>
      <view class="rel-zhis-row">
        <text class="rel-zhis serif" wx:for="{{item.items}}" wx:for-item="it" wx:key="zhis">{{it.zhis}}<text wx:if="{{it.luck}}" class="rel-zhis-luck">↑</text>  </text>
      </view>
      <view class="pc pc-on">{{item.text}}</view>
    </view>
  </view>

  <view class="foot">性格画像基于出生信息的结构化分析，仅供娱乐参考</view>
</view>
