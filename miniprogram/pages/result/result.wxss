.page {
  padding: 24rpx 24rpx 160rpx;
}

/* 选项卡 */
.tabs {
  display: flex;
  background: var(--fill);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  color: var(--ink-2);
  border-radius: 14rpx;
}
.tab-on {
  background: linear-gradient(135deg, #9D78F8, #6C4BD9);
  color: #FBF9FF;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(124, 92, 224, 0.4);
}

/* 命主信息 */
.info {
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.info-head {
  display: flex;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed var(--line);
  margin-bottom: 16rpx;
}
.info-name {
  font-size: 38rpx;
  font-weight: 700;
}
.info-tag {
  font-size: 22rpx;
  color: #1A142E;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
  font-weight: 600;
}
.tag-m { background: #6FB6FF; }
.tag-f { background: #F2A7C3; }
.info-sx {
  margin-left: auto;
  font-size: 26rpx;
  color: var(--gold);
}
.info-row {
  display: flex;
  font-size: 26rpx;
  padding: 6rpx 0;
  color: var(--ink);
}
.info-label {
  width: 150rpx;
  color: var(--ink-3);
  flex-shrink: 0;
}
.info-note {
  color: var(--ink-3);
  font-size: 24rpx;
}

/* 命盘表（基础盘四柱 / 详盘六柱） */
.chart {
  padding: 20rpx 12rpx;
  margin-bottom: 24rpx;
}
.chart-row {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid var(--line);
  padding: 14rpx 0;
}
.chart-row.no-line {
  border-bottom: none;
}
.cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}
/* 大运/流年扩展柱：紫晕底色突出 */
.cell-extra {
  background: var(--tint);
}
.label-cell {
  flex: 0 0 76rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  justify-content: center;
}
.head-row {
  padding: 6rpx 0 12rpx;
}
.head-name {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--ink);
}
.cell-extra .head-name {
  color: var(--primary);
}
.head-sub {
  font-size: 18rpx;
  color: var(--ink-3);
}
.shishen {
  font-size: 24rpx;
  color: var(--ink-2);
}
.rizhu {
  font-size: 22rpx;
  color: var(--pink);
  border: 1rpx solid var(--pink);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.big-char {
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.2;
}
.wx-mark {
  font-size: 20rpx;
  opacity: 0.7;
}
.hide-gan {
  display: flex;
  align-items: baseline;
  padding: 2rpx 0;
}
.hg-char {
  font-size: 26rpx;
  font-weight: 600;
}
.hg-ss {
  font-size: 20rpx;
  color: var(--ink-3);
  margin-left: 6rpx;
}
.plain {
  font-size: 24rpx;
}
.naying {
  font-size: 20rpx;
  text-align: center;
}
.dim {
  color: var(--ink-3);
}
.shensha-row .cell {
  justify-content: flex-start;
}
.ss-item {
  font-size: 20rpx;
  color: var(--ink-2);
  padding: 2rpx 0;
  text-align: center;
}
.ss-none {
  font-size: 20rpx;
  color: var(--ink-3);
}

/* 五行 */
.wuxing {
  padding: 24rpx 32rpx 28rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 18rpx;
}
.section-note {
  font-size: 22rpx;
  color: var(--ink-3);
  font-weight: 400;
  margin-left: 12rpx;
}
.wx-bar {
  display: flex;
  justify-content: space-between;
  padding: 0 12rpx;
}
.wx-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.wx-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #1A142E;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}
.wx-count {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}
.wx-lack {
  color: var(--pink);
  font-weight: 700;
}

/* 大运/流年选择条 */
.yun-card {
  padding: 24rpx 24rpx 28rpx;
  margin-bottom: 24rpx;
}
.yun-scroll {
  white-space: nowrap;
}
.yun-strip {
  display: inline-flex;
}
.yun-cell {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  width: 124rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  background: var(--fill);
  flex-shrink: 0;
}
.yun-on {
  background: var(--tint);
  border-color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(124, 92, 224, 0.3);
}
.yun-ss {
  font-size: 20rpx;
  color: var(--ink-3);
}
.yun-gz {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin: 4rpx 0;
}
.yun-year {
  font-size: 22rpx;
  color: var(--ink-2);
}
.yun-age {
  font-size: 20rpx;
  color: var(--ink-3);
}

/* 流月 */
.liuyue-grid {
  display: flex;
  flex-wrap: wrap;
}
.liuyue-cell {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  box-sizing: border-box;
}
.ly-name {
  font-size: 22rpx;
  color: var(--ink-3);
}
.ly-gz {
  font-size: 32rpx;
  font-weight: 700;
  margin: 2rpx 0;
}
.ly-ss {
  font-size: 20rpx;
  color: var(--ink-2);
}

/* 保存栏 */
.bottom-space {
  height: 20rpx;
}
.savebar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(20, 16, 31, 0.92);
  border-top: 1rpx solid var(--line);
  backdrop-filter: blur(20rpx);
}
.btn-save {
  height: 92rpx;
  line-height: 92rpx;
}
.btn-saved {
  background: #3A3158;
  box-shadow: none;
  color: var(--ink-2);
}
