<view class="page fs-{{fs}}" wx:if="{{loaded}}">

  <!-- 选项卡 -->
  <view class="tabs">
    <view class="tab serif {{tab === 'base' ? 'tab-on' : ''}}" bindtap="onTab" data-tab="base">基础盘</view>
    <view class="tab serif {{tab === 'detail' ? 'tab-on' : ''}}" bindtap="onTab" data-tab="detail">详盘</view>
    <view class="tab serif {{tab === 'info' ? 'tab-on' : ''}}" bindtap="onTab" data-tab="info">基本信息</view>
    <view class="tab tab-energy serif {{tab === 'energy' ? 'tab-on' : ''}}" bindtap="onTab" data-tab="energy">能量盘<text class="tab-free">免费</text></view>
  </view>

  <!-- 盘面页：仅保留精简生日条 -->
  <view class="card birth-strip" wx:if="{{tab === 'base' || tab === 'detail'}}">
    <text class="info-tag {{meta.gender === 1 ? 'tag-m' : 'tag-f'}}">{{meta.gender === 1 ? '乾造' : '坤造'}}</text>
    <text class="birth-main">{{meta.clockStr}}</text>
    <text class="birth-lunar">{{meta.lunarShort}}</text>
  </view>

  <!-- 出生星图入口（基础盘内，默认静止，进入后可时光流动）-->
  <view class="astro-entry" wx:if="{{tab === 'base'}}" hover-class="astro-entry-hover" bindtap="goAstro">
    <starfield class="astro-preview" ts="{{meta.timestamp}}" flow="{{false}}" spin="{{false}}" />
    <view class="astro-body">
      <view class="astro-tag">星河 · 亮点</view>
      <view class="astro-title serif">出生星图</view>
      <view class="astro-sub">你出生那一刻，日月五星的真实位置</view>
      <view class="astro-cta">进入 3D 星图 ›</view>
    </view>
  </view>

  <!-- 基本信息页 -->
  <view class="card info" wx:if="{{tab === 'info'}}">
    <view class="info-head">
      <text class="info-name serif">{{meta.name || '未署名'}}</text>
      <text class="info-tag {{meta.gender === 1 ? 'tag-m' : 'tag-f'}}">{{meta.gender === 1 ? '乾造' : '坤造'}}</text>
      <text class="info-sx">属{{meta.shengXiao}}</text>
    </view>
    <view class="info-row"><text class="info-label">公　历</text><text>{{meta.clockStr}}</text></view>
    <view class="info-row"><text class="info-label">农　历</text><text>{{meta.lunarStr}}</text></view>
    <view class="info-row" wx:if="{{meta.useTrueSolar}}">
      <text class="info-label">真太阳时</text>
      <text>{{meta.chartStr}}<text class="info-note">（修正{{meta.offsetMinutes >= 0 ? '+' : ''}}{{meta.offsetMinutes}}分）</text></text>
    </view>
    <view class="info-row" wx:if="{{meta.location}}"><text class="info-label">出生地</text><text>{{meta.location}}</text></view>
    <view class="info-row"><text class="info-label">八　字</text><text class="serif info-bazi">{{baZiStr}}</text></view>
    <view class="info-row"><text class="info-label">起　运</text><text>{{meta.qiYun}}<text class="info-note">（{{meta.qiYunDate}} 交运）</text></text></view>
  </view>

  <!-- 命盘表：基础盘四柱 / 详盘六柱（大运、流年在左） -->
  <view class="card chart" wx:if="{{tab === 'base' || tab === 'detail'}}">
    <view class="chart-row head-row">
      <view class="cell label-cell"></view>
      <view class="cell head-cell {{item.extra || item.empty ? 'cell-extra' : ''}}" wx:for="{{tablePillars}}" wx:key="label">
        <view class="serif head-name">{{item.label}}</view>
        <view class="head-sub" wx:if="{{item.sub}}">{{item.sub}}</view>
      </view>
    </view>

    <view class="chart-row">
      <view class="cell label-cell">主星</view>
      <view class="cell {{item.extra || item.empty ? 'cell-extra' : ''}}" wx:for="{{tablePillars}}" wx:key="label">
        <text wx:if="{{item.empty}}" class="dim">—</text>
        <text wx:elif="{{item.shiShenGan === '日主'}}" class="rizhu">日主</text>
        <text wx:else class="shishen" bindtap="onTermTap" data-term="{{item.shiShenGan}}">{{item.shiShenGan}}</text>
      </view>
    </view>

    <view class="chart-row">
      <view class="cell label-cell">天干</view>
      <view class="cell {{item.extra || item.empty ? 'cell-extra' : ''}}" wx:for="{{tablePillars}}" wx:key="label">
        <block wx:if="{{!item.empty}}">
          <view class="big-char serif wx-{{item.gan.cls}}">{{item.gan.text}}</view>
          <view class="wx-mark wx-{{item.gan.cls}}"><view class="el-ico el-{{item.gan.cls}}"></view><text>{{item.gan.wx}}</text></view>
        </block>
        <text wx:else class="dim">—</text>
      </view>
    </view>

    <view class="chart-row">
      <view class="cell label-cell">地支</view>
      <view class="cell {{item.extra || item.empty ? 'cell-extra' : ''}}" wx:for="{{tablePillars}}" wx:key="label">
        <block wx:if="{{!item.empty}}">
          <view class="big-char serif wx-{{item.zhi.cls}}">{{item.zhi.text}}</view>
          <view class="wx-mark wx-{{item.zhi.cls}}"><view class="el-ico el-{{item.zhi.cls}}"></view><text>{{item.zhi.wx}}</text></view>
        </block>
        <text wx:else class="dim">—</text>
      </view>
    </view>

    <view class="chart-row">
      <view class="cell label-cell">藏干</view>
      <view class="cell {{item.extra || item.empty ? 'cell-extra' : ''}}" wx:for="{{tablePillars}}" wx:key="label">
        <view class="hide-gan" wx:for="{{item.hideGans}}" wx:for-item="hg" wx:key="text"
          bindtap="onTermTap" data-term="{{hg.shiShen}}">
          <text class="hg-char wx-{{hg.cls}}">{{hg.text}}</text>
          <text class="hg-ss">{{hg.shiShen}}</text>
        </view>
        <text wx:if="{{item.empty}}" class="dim">—</text>
      </view>
    </view>

    <view class="sub-toggle" bindtap="onToggleSubRows">
      <text class="sub-toggle-t">{{showSubRows ? '收起' : '展开'}}星运 · 自坐 · 空亡 · 纳音 · 神煞</text>
      <text class="sub-arrow {{showSubRows ? 'sub-arrow-up' : ''}}">▾</text>
    </view>
    <block wx:if="{{showSubRows}}">
    <view class="chart-row">
      <view class="cell label-cell">星运</view>
      <view class="cell {{item.extra || item.empty ? 'cell-extra' : ''}}" wx:for="{{tablePillars}}" wx:key="label">
        <text class="plain" bindtap="onTermTap" data-term="{{item.xingYun}}">{{item.empty ? '—' : item.xingYun}}</text>
      </view>
    </view>

    <view class="chart-row">
      <view class="cell label-cell">自坐</view>
      <view class="cell {{item.extra || item.empty ? 'cell-extra' : ''}}" wx:for="{{tablePillars}}" wx:key="label">
        <text class="plain" bindtap="onTermTap" data-term="{{item.ziZuo}}">{{item.empty ? '—' : item.ziZuo}}</text>
      </view>
    </view>

    <view class="chart-row">
      <view class="cell label-cell">空亡</view>
      <view class="cell {{item.extra || item.empty ? 'cell-extra' : ''}}" wx:for="{{tablePillars}}" wx:key="label">
        <text class="plain dim">{{item.empty ? '—' : item.xunKong}}</text>
      </view>
    </view>

    <view class="chart-row">
      <view class="cell label-cell">纳音</view>
      <view class="cell {{item.extra || item.empty ? 'cell-extra' : ''}}" wx:for="{{tablePillars}}" wx:key="label">
        <text class="plain dim naying" bindtap="onTermTap" data-term="{{item.naYin}}">{{item.empty ? '—' : item.naYin}}</text>
      </view>
    </view>

    <view class="chart-row no-line shensha-row">
      <view class="cell label-cell">神煞</view>
      <view class="cell {{item.extra || item.empty ? 'cell-extra' : ''}}" wx:for="{{tablePillars}}" wx:key="label">
        <text class="ss-item" wx:for="{{item.shenSha}}" wx:for-item="ss" wx:key="*this"
          bindtap="onTermTap" data-term="{{ss}}">{{ss}}</text>
        <text class="ss-none" wx:if="{{item.empty || item.shenSha.length === 0}}">—</text>
      </view>
    </view>
    </block>
  </view>

  <!-- 详盘：大运/流年选择条 + 流月 -->
  <block wx:if="{{tab === 'detail'}}">
    <view class="card yun-card">
      <view class="section-title serif">大运 <text class="section-note">{{meta.qiYun}} · 点击切换上表大运柱</text></view>
      <scroll-view class="yun-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="yun-strip">
          <view class="yun-cell {{dyIndex === item.index ? 'yun-on' : ''}}"
            wx:for="{{daYunBar}}" wx:key="index"
            bindtap="onDaYunTap" data-index="{{item.index}}">
            <block wx:if="{{item.isQian}}">
              <view class="yun-ss">　</view>
              <view class="yun-gz serif dim">童限</view>
            </block>
            <block wx:else>
              <view class="yun-ss" catchtap="onTermTap" data-term="{{item.shiShenGan}}">{{item.shiShenGan}}</view>
              <view class="yun-gz serif">
                <text class="wx-{{item.gan.cls}}">{{item.gan.text}}</text><text class="wx-{{item.zhi.cls}}">{{item.zhi.text}}</text>
              </view>
            </block>
            <view class="yun-year">{{item.startYear}}</view>
            <view class="yun-age">{{item.startAge}}岁</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="card yun-card">
      <view class="section-title serif">流年 <text class="section-note">点击切换上表流年柱</text></view>
      <scroll-view class="yun-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="yun-strip">
          <view class="yun-cell {{lnIndex === item.index ? 'yun-on' : ''}}"
            wx:for="{{liuNianBar}}" wx:key="index"
            bindtap="onLiuNianTap" data-index="{{item.index}}">
            <view class="yun-ss" catchtap="onTermTap" data-term="{{item.shiShenGan}}">{{item.shiShenGan}}</view>
            <view class="yun-gz serif">
              <text class="wx-{{item.gan.cls}}">{{item.gan.text}}</text><text class="wx-{{item.zhi.cls}}">{{item.zhi.text}}</text>
            </view>
            <view class="yun-year">{{item.year}}</view>
            <view class="yun-age">{{item.age}}岁</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 流月（与流年同样式，点选生成流月柱） -->
    <view class="card yun-card" wx:if="{{liuYueBar.length}}">
      <view class="section-title serif">流月 <text class="section-note">点击生成流月柱（默认不挂）</text></view>
      <scroll-view class="yun-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="yun-strip">
          <view class="yun-cell {{lyIndex === item.index ? 'yun-on' : ''}}"
            wx:for="{{liuYueBar}}" wx:key="index"
            bindtap="onLiuYueTap" data-index="{{item.index}}">
            <view class="yun-ss" catchtap="onTermTap" data-term="{{item.shiShenGan}}">{{item.shiShenGan}}</view>
            <view class="yun-gz serif">
              <text class="wx-{{item.gan.cls}}">{{item.gan.text}}</text><text class="wx-{{item.zhi.cls}}">{{item.zhi.text}}</text>
            </view>
            <view class="yun-year">{{item.name}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 流日（平铺，点选生成流日柱） -->
    <view class="card yun-card" wx:if="{{liuRiBar.length}}">
      <view class="section-title serif">流日 <text class="section-note">{{liuYueBar[lyIndex].name}} · 点击生成流日柱</text></view>
      <view class="liuri-grid">
        <view class="liuri-cell {{lrIndex === item.index ? 'lr-on' : ''}}"
          wx:for="{{liuRiBar}}" wx:key="index"
          bindtap="onLiuRiTap" data-index="{{item.index}}">
          <view class="lr-date">{{item.label}}</view>
          <view class="lr-gz serif">
            <text class="wx-{{item.gan.cls}}">{{item.gan.text}}</text><text class="wx-{{item.zhi.cls}}">{{item.zhi.text}}</text>
          </view>
          <view class="lr-ss">{{item.shiShenGan}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 能量盘 -->
  <block wx:if="{{tab === 'energy'}}">
    <view class="q-curbar card">
      <text class="q-cur">{{qCurLabel}}</text>
      <text class="q-tip">日主{{meta.dayGan}}</text>
    </view>

    <view class="modes">
      <view class="mode {{qMode === 'fill' ? 'on' : ''}}" bindtap="onQMode" data-mode="fill">充能水位</view>
      <view class="mode {{qMode === 'size' ? 'on' : ''}}" bindtap="onQMode" data-mode="size">字号大小</view>
    </view>

    <view class="card disk">
      <view class="cols">
        <view class="ch-col" wx:for="{{qGanCells}}" wx:key="pos"><text class="pos">{{item.pos}}</text></view>
      </view>
      <view class="cells">
        <view class="q-cell" wx:for="{{qGanCells}}" wx:key="pos">
          <view wx:if="{{qMode === 'fill'}}" class="fillbox {{item.isDay ? 'is-day' : ''}}">
            <view class="fill bg-{{item.cls}}" style="height:{{item.fill}}%"></view>
            <text class="fill-ch">{{item.char}}</text>
          </view>
          <view wx:else class="sizebox {{item.isDay ? 'is-day' : ''}}">
            <text class="size-ch wx-{{item.cls}}" style="font-size:{{item.fs}}rpx">{{item.char}}</text>
          </view>
          <text class="qgod">{{item.god}}</text>
        </view>
      </view>
      <view class="cells">
        <view class="q-cell" wx:for="{{qZhiCells}}" wx:key="pos">
          <view wx:if="{{qMode === 'fill'}}" class="fillbox">
            <view class="fill bg-{{item.cls}}" style="height:{{item.fill}}%"></view>
            <text class="fill-ch">{{item.char}}</text>
          </view>
          <view wx:else class="sizebox">
            <text class="size-ch wx-{{item.cls}}" style="font-size:{{item.fs}}rpx">{{item.char}}</text>
          </view>
          <text class="qgod">{{item.god}}</text>
        </view>
      </view>
      <view class="ws">
        <view class="ws-bar"><view class="ws-same" style="width:{{qpNow}}%"></view></view>
        <view class="ws-legend">
          <text class="lg-same">生扶 {{qpNow}}%</text>
          <text class="lg-delta" wx:if="{{qHasLuck && qpNow !== qpBase}}">原局 {{qpBase}}% → {{qpNow}}%</text>
          <text class="lg-diff">克泄耗 {{100 - qpNow}}%</text>
        </view>
      </view>
    </view>

    <view class="card yun-card">
      <view class="section-title serif">大运 <text class="section-note">点选叠加，重复点取消</text></view>
      <scroll-view class="yun-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="yun-strip">
          <view class="yun-cell {{qDyIndex === item.index ? 'yun-on' : ''}}"
            wx:for="{{qDaYunList}}" wx:key="index" bindtap="onQDaYun" data-index="{{item.index}}">
            <view class="yun-ss">{{item.god}}</view>
            <view class="yun-gz serif"><text class="wx-{{item.gan.cls}}">{{item.gan.text}}</text><text class="wx-{{item.zhi.cls}}">{{item.zhi.text}}</text></view>
            <view class="yun-age">{{item.age}}岁</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="card yun-card" wx:if="{{qLiuNianList.length}}">
      <view class="section-title serif">流年 <text class="section-note">{{qDaYunList[qDyIndex].gz}} 运内</text></view>
      <scroll-view class="yun-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="yun-strip">
          <view class="yun-cell {{qLnIndex === item.index ? 'yun-on' : ''}}"
            wx:for="{{qLiuNianList}}" wx:key="index" bindtap="onQLiuNian" data-index="{{item.index}}">
            <view class="yun-ss">{{item.god}}</view>
            <view class="yun-gz serif"><text class="wx-{{item.gan.cls}}">{{item.gan.text}}</text><text class="wx-{{item.zhi.cls}}">{{item.zhi.text}}</text></view>
            <view class="yun-year">{{item.year}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="q-foot">字越大 / 水位越高，该字（十神）能量越强 · 岁运令原局逐字升降</view>
  </block>

  <!-- 五行 -->
  <view class="card wuxing" wx:if="{{tab === 'base' || tab === 'detail'}}">
    <view class="section-title serif">五行</view>
    <view class="wx-bar">
      <view class="wx-item" wx:for="{{wuXing}}" wx:key="wx">
        <view class="wx-dot bg-{{item.cls}}">{{item.wx}}</view>
        <view class="wx-count {{item.count === 0 ? 'wx-lack' : ''}}">{{item.count === 0 ? '缺' : item.count}}</view>
      </view>
    </view>
  </view>

  <view class="page-footer">命盘仅供传统文化娱乐参考，不构成人生决策依据</view>

  <view class="bottom-space"></view>

  <!-- 底部操作栏：保存 + 详批 -->
  <view class="savebar">
    <button class="btn-save {{saved ? 'btn-saved' : ''}}" bindtap="onSave">
      {{saved ? '已保存' : '保存'}}
    </button>
    <button class="btn-xiangpi" bindtap="onXiangPi">详批</button>
  </view>

  <!-- 词条解读卡（十神/长生/神煞/纳音） -->
  <view class="ss-mask" wx:if="{{termCard}}" bindtap="closeTermCard">
    <view class="ss-sheet card" catchtap="noop">
      <view class="ss-sheet-head">
        <text class="ss-sheet-name serif">{{termCard.name}}</text>
        <text class="ss-sheet-brief">{{termCard.brief}}</text>
      </view>
      <view class="ss-block ss-block-{{block.type}}" wx:for="{{termCard.blocks}}" wx:for-item="block" wx:key="title">
        <view class="ss-block-title" wx:if="{{block.title}}">{{block.title}}</view>
        <view class="ss-block-text">{{block.text}}</view>
      </view>
      <view class="ss-sheet-close" bindtap="closeTermCard">知道了</view>
    </view>
  </view>
</view>
