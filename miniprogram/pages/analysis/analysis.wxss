.page {
  padding: 28rpx 28rpx 56rpx;
}

/* 命主头卡 */
.head-card {
  padding: 30rpx 32rpx;
  margin-bottom: 24rpx;
}
.head-row {
  display: flex;
  align-items: baseline;
}
.head-name {
  font-size: 36rpx;
  font-weight: 700;
}
.head-meta {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--ink-3);
}
.bz-row {
  display: flex;
  margin-top: 24rpx;
}
.bz-col {
  flex: 1;
  text-align: center;
}
.bz-label {
  font-size: 20rpx;
  color: var(--ink-3);
  margin-bottom: 8rpx;
}
.bz-gan, .bz-zhi {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}
.summary {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--line);
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

/* 分析区块 */
.sec {
  padding: 30rpx 32rpx;
  margin-bottom: 24rpx;
}
.sec-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.sec-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  color: #FBF9FF;
  flex-shrink: 0;
}
.tag-ws { background: linear-gradient(135deg, #9D78F8, #6C4BD9); }
.tag-th { background: linear-gradient(135deg, #6FB6FF, #3D6F9E); }
.tag-gj { background: linear-gradient(135deg, #E8C886, #C09A4E); }
.tag-xg { background: linear-gradient(135deg, #F285AE, #C9508A); }
.tag-jk { background: linear-gradient(135deg, #5ECC8F, #359360); }
.sec-title {
  font-size: 32rpx;
  font-weight: 700;
}
.sec-kind {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--ink-3);
}
.sec-line {
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--ink-2);
  margin-bottom: 8rpx;
}
.sec-verdict {
  margin-top: 6rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}
.sec-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-3);
}

/* 旺衰能量条 */
.ws-bar {
  height: 18rpx;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #C9508A, #F285AE);
  overflow: hidden;
  margin-bottom: 10rpx;
}
.ws-same {
  height: 100%;
  border-radius: 10rpx 0 0 10rpx;
  background: linear-gradient(90deg, #6C4BD9, #9D78F8);
}
.ws-legend {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  margin-bottom: 18rpx;
}
.ws-lg-same { color: #6D5DF6; }
.ws-lg-diff { color: #EC5C8D; }

/* 喜忌 / 用神 chips */
.chip-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 14rpx 0;
}
.chip-label {
  font-size: 22rpx;
  color: var(--ink-3);
}
.chip-label-ji {
  margin-left: 18rpx;
}
.wx-chip {
  font-size: 26rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--fill);
  border: 1rpx solid var(--line);
}
.wx-chip-ji {
  color: var(--ink-3);
  text-decoration: line-through;
}
.yong-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--fill);
  border: 1rpx solid var(--line);
}
.yong-gan {
  font-size: 28rpx;
  font-weight: 700;
}
.yong-status {
  font-size: 20rpx;
}
.st-tou { color: #16A971; }
.st-cang { color: var(--gold); }
.st-none { color: var(--ink-3); }

/* 性格 */
.xg-item {
  margin-bottom: 22rpx;
}
.xg-item:last-child {
  margin-bottom: 0;
}
.xg-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}
.xg-text {
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--ink-2);
}

/* 健康 */
.jk-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.jk-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.jk-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.jk-level {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.lv-high { background: rgba(236, 92, 141, 0.12); color: #D94D7E; border: 1rpx solid rgba(236, 92, 141, 0.35); }
.lv-mid { background: rgba(227, 194, 126, 0.15); color: var(--gold); border: 1rpx solid rgba(227, 194, 126, 0.35); }
.lv-low { background: var(--fill); color: var(--ink-3); border: 1rpx solid var(--line); }
.jk-organ {
  font-size: 28rpx;
  font-weight: 700;
}
.jk-parts {
  margin-left: 14rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.jk-reason {
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--ink-2);
}
.jk-advice {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--ink-3);
}

.footer {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
  margin-top: 8rpx;
}

/* 字号档位 */
.fs-l .sec-line, .fs-l .xg-text { font-size: 29rpx; }
.fs-l .jk-reason { font-size: 28rpx; }
.fs-l .jk-advice { font-size: 27rpx; }
.fs-l .summary { font-size: 29rpx; }
.fs-l .sec-note { font-size: 27rpx; }
.fs-xl .sec-line, .fs-xl .xg-text { font-size: 32rpx; }
.fs-xl .jk-reason { font-size: 31rpx; }
.fs-xl .jk-advice { font-size: 30rpx; }
.fs-xl .summary { font-size: 32rpx; }
.fs-xl .sec-note { font-size: 30rpx; }
