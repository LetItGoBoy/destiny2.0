.page {
  padding: 32rpx 28rpx 48rpx;
}

.head {
  padding: 8rpx 8rpx 24rpx;
}
.head-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.head-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 搜索 + 筛选 */
.search-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}
.search {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx;
  border-radius: 100rpx;
  margin-bottom: 0;
}
.search-ico {
  font-size: 38rpx;
  color: var(--ink-3);
  margin-right: 16rpx;
  transform: rotate(-45deg);
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}
.search-ph {
  color: var(--ink-3);
}
.search-clear {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--fill);
  color: var(--ink-3);
  font-size: 24rpx;
  margin-left: 12rpx;
}
.filter-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 72rpx;
  padding: 0 30rpx;
  border-radius: 100rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  color: var(--ink-2);
}
.filter-on {
  background: var(--tint);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 600;
}
.filter-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 100rpx;
  background: var(--primary);
  color: #fff;
  font-size: 20rpx;
  padding: 0 8rpx;
}
.search-hint {
  font-size: 22rpx;
  color: var(--ink-3);
  padding: 0 16rpx 18rpx;
}

/* 筛选面板 */
.filter-panel {
  padding: 24rpx 28rpx 20rpx;
  margin-bottom: 16rpx;
}
.fp-sec-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  margin: 16rpx 0 14rpx;
}
.fp-sec-t:first-child {
  margin-top: 0;
}
.fp-sec-note {
  font-size: 21rpx;
  font-weight: 400;
  color: var(--ink-3);
  margin-left: 14rpx;
}
.gender-row {
  display: flex;
  gap: 16rpx;
}
.g-chip {
  min-width: 120rpx;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 14rpx;
  background: var(--fill);
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  color: var(--ink-2);
}
.g-chip-on {
  background: var(--tint);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 600;
}

/* 干支选择网格 */
.gz-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.gz-ch {
  width: calc((100% - 80rpx) / 10);
  text-align: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  background: var(--fill);
  border: 1rpx solid var(--line);
  font-size: 30rpx;
  font-weight: 700;
}

/* 四柱插槽 */
.four-pillars {
  display: flex;
  gap: 12rpx;
}
.fp-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.fp-label {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-bottom: 2rpx;
}
.fp-slot {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 14rpx;
  background: var(--fill);
  border: 1rpx solid var(--line);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink-3);
}
.fp-filled {
  color: var(--ink);
  background: #fff;
}
.fp-on {
  border-color: var(--primary);
  border-width: 2rpx;
  background: var(--tint);
}

.fp-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}
.fp-reset, .fp-done {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.fp-reset {
  background: var(--fill);
  color: var(--ink-2);
  border: 1rpx solid var(--line);
}
.fp-done {
  background: linear-gradient(135deg, #6D5DF6, #5B8DEF);
  color: #fff;
}

/* 记录卡片：左信息 + 右干支 + 头像 */
.rec {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
}
.rec-hover {
  opacity: 0.85;
}
.rec-left {
  flex: 1;
  min-width: 0;
}
.rec-line1 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}
.rec-name {
  font-size: 32rpx;
  font-weight: 600;
}
.rec-gender {
  font-size: 20rpx;
  color: #1A142E;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.g-m { background: #6FB6FF; }
.g-f { background: #F2A7C3; }
.rec-self {
  font-size: 20rpx;
  color: #1A142E;
  font-weight: 600;
  background: var(--gold);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}
.rec-true {
  font-size: 20rpx;
  color: var(--gold);
  border: 1rpx solid var(--gold);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.rec-date {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 右侧干支：天干一行、地支一行 */
.rec-right {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin: 0 20rpx 0 16rpx;
  flex-shrink: 0;
}
.rec-gz-row {
  display: flex;
}
.rgz {
  width: 38rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
}

/* 头像（日主天干，五行底色） */
.rec-ava {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
}

/* 无结果 */
.no-result {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: var(--ink-3);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}
.empty-seal {
  width: 120rpx;
  height: 120rpx;
  font-size: 56rpx;
  opacity: 0.85;
}
.empty-text {
  margin-top: 36rpx;
  font-size: 30rpx;
  color: var(--ink-2);
}
.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
.empty-btn {
  margin-top: 48rpx;
  width: 320rpx;
  height: 88rpx;
}

/* 字号档位：大 */
.fs-l .rec-name { font-size: 36rpx; }
.fs-l .rgz { font-size: 35rpx; width: 40rpx; }
.fs-l .rec-date { font-size: 27rpx; }
.fs-l .search-input { font-size: 31rpx; }
.fs-l .head-sub { font-size: 26rpx; }
.fs-l .rec-gender, .fs-l .rec-self, .fs-l .rec-true { font-size: 22rpx; }

/* 字号档位：特大 */
.fs-xl .rec-name { font-size: 40rpx; }
.fs-xl .rgz { font-size: 38rpx; width: 42rpx; }
.fs-xl .rec-date { font-size: 30rpx; }
.fs-xl .search-input { font-size: 34rpx; }
.fs-xl .head-sub { font-size: 28rpx; }
.fs-xl .rec-gender, .fs-xl .rec-self, .fs-xl .rec-true { font-size: 24rpx; }
