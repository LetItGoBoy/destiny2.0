.page {
  padding: 32rpx 28rpx 48rpx;
}

.head {
  padding: 8rpx 8rpx 24rpx;
}
.head-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.head-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 搜索栏 */
.search {
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx;
  border-radius: 100rpx;
  margin-bottom: 14rpx;
}
.search-ico {
  font-size: 38rpx;
  color: var(--ink-3);
  margin-right: 16rpx;
  transform: rotate(-45deg);
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}
.search-ph {
  color: var(--ink-3);
}
.search-clear {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--fill);
  color: var(--ink-3);
  font-size: 24rpx;
  margin-left: 12rpx;
}
.search-hint {
  font-size: 22rpx;
  color: var(--ink-3);
  padding: 0 16rpx 18rpx;
}

/* 柱位筛选 */
.pillar-chips {
  display: flex;
  gap: 14rpx;
  padding: 4rpx 4rpx 16rpx;
}
.p-chip {
  padding: 8rpx 28rpx;
  border-radius: 100rpx;
  border: 1rpx solid var(--line);
  background: var(--fill);
  font-size: 24rpx;
  color: var(--ink-2);
}
.p-chip-on {
  background: var(--tint);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 600;
}

/* 干支聚合分组 */
.group {
  margin-bottom: 12rpx;
}
.group-head {
  display: flex;
  align-items: baseline;
  padding: 16rpx 12rpx 14rpx;
}
.group-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 2rpx;
}
.group-kw {
  margin-left: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--gold);
  letter-spacing: 2rpx;
}
.group-count {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 记录卡片 */
.rec {
  padding: 26rpx 30rpx;
  margin-bottom: 20rpx;
}
.rec-hover {
  opacity: 0.85;
}
.rec-line1 {
  display: flex;
  align-items: center;
}
.rec-name {
  font-size: 32rpx;
  font-weight: 600;
}
.rec-gender {
  font-size: 20rpx;
  color: #1A142E;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 14rpx;
}
.g-m { background: #6FB6FF; }
.g-f { background: #F2A7C3; }
.rec-true {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--gold);
  border: 1rpx solid var(--gold);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.rec-bazi {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.bz-pillar {
  margin-right: 20rpx;
}
.rec-line3 {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 无结果 */
.no-result {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: var(--ink-3);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}
.empty-seal {
  width: 120rpx;
  height: 120rpx;
  font-size: 56rpx;
  opacity: 0.85;
}
.empty-text {
  margin-top: 36rpx;
  font-size: 30rpx;
  color: var(--ink-2);
}
.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
.empty-btn {
  margin-top: 48rpx;
  width: 320rpx;
  height: 88rpx;
}
