.page {
  padding: 32rpx 28rpx 48rpx;
}

/* 用户卡片 */
.profile {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
}
.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: 1;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}
.avatar-btn::after {
  border: none;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}
.avatar-default {
  border-radius: 50%;
  font-size: 52rpx;
}
.profile-body {
  margin-left: 26rpx;
  flex: 1;
  min-width: 0;
}
.nickname {
  width: 100%;
  height: 56rpx;
  min-height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  font-size: 34rpx;
  font-weight: 700;
}
.nick-ph {
  color: var(--ink-3);
  font-weight: 400;
}
.profile-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  white-space: nowrap;
}
.profile-stat {
  text-align: center;
  padding-left: 20rpx;
  margin-left: 16rpx;
  border-left: 1rpx solid var(--line);
  flex-shrink: 0;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
}
.stat-label {
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 显示字号 */
.fontcard {
  padding: 28rpx 32rpx;
  margin-bottom: 28rpx;
}
.font-head {
  display: flex;
  align-items: baseline;
}
.font-title {
  font-size: 30rpx;
  font-weight: 600;
}
.font-note {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--ink-3);
}
.font-chips {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
}
.f-chip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--line);
  background: var(--fill);
  color: var(--ink-2);
  font-size: 26rpx;
}
.f-chip-l { font-size: 30rpx; }
.f-chip-xl { font-size: 34rpx; }
.f-chip-on {
  background: var(--tint);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 600;
}
.font-preview {
  margin-top: 22rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--ink-2);
  letter-spacing: 2rpx;
}
.fs-l .font-preview { font-size: 32rpx; }
.fs-xl .font-preview { font-size: 38rpx; }

/* 字号档位 */
.fs-l .cell-title { font-size: 33rpx; }
.fs-l .nickname { font-size: 37rpx; height: 60rpx; min-height: 60rpx; line-height: 60rpx; }
.fs-l .profile-sub, .fs-l .stat-label { font-size: 24rpx; }
.fs-xl .cell-title { font-size: 36rpx; }
.fs-xl .nickname { font-size: 40rpx; height: 66rpx; min-height: 66rpx; line-height: 66rpx; }
.fs-xl .profile-sub, .fs-xl .stat-label { font-size: 26rpx; }

/* 功能列表 */
.cells {
  margin-bottom: 28rpx;
  overflow: hidden;
}
.cell {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
}
.cell:last-child {
  border-bottom: none;
}
.cell-hover {
  background: var(--fill);
}
.cell-ico {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #7FA8F2, #5470D9);
  color: #FBF9FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 22rpx;
}
.cell-ico-gold {
  background: linear-gradient(135deg, #E8C886, #C09A4E);
}
.cell-ico-red {
  background: linear-gradient(135deg, #F285AE, #C9508A);
}
.cell-title {
  flex: 1;
  font-size: 30rpx;
}
.cell-danger {
  color: var(--pink);
}
.cell-arrow {
  color: var(--ink-3);
  font-size: 34rpx;
}

.footer {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
}

.footer-ver {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: var(--ink-3);
  opacity: 0.7;
}
