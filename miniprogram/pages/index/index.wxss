.page {
  padding: 32rpx 28rpx 48rpx;
  overflow: hidden;
}
.hero,
.starhero,
.form,
.recent,
.footer {
  position: relative;
  z-index: 1;
}

/* 头部 */
.hero {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx 36rpx;
}
.logo {
  flex: none;
  width: 108rpx;
  height: 108rpx;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(20, 8, 6, 0.28);
  background: #140808;
}
.hero-right {
  margin-left: 26rpx;
}
.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--ink);
}
.hero-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
}

/* 长辈模式开关（右上角一键放大全站字号） */
.elder-toggle {
  margin-left: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  padding: 10rpx 18rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--line, #e3ddd0);
  background: var(--card, #fff);
  color: var(--ink-3, #8a8170);
}
.elder-toggle .elder-aa {
  font-weight: 700;
  font-size: 26rpx;
  line-height: 1;
}
.elder-toggle .elder-aa-big { font-size: 36rpx; }
.elder-toggle .elder-tx {
  font-size: 20rpx;
  letter-spacing: 1rpx;
}
.elder-toggle.on {
  border-color: var(--primary, #8A2B27);
  background: var(--primary-soft, rgba(138, 43, 39, 0.12));
  color: var(--primary, #8A2B27);
}
.fs-xl .elder-toggle .elder-tx { font-size: 24rpx; }

/* 此刻星象 Hero（深色星河面板，浮于浅色页面） */
.starhero {
  position: relative;
  height: 400rpx;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: radial-gradient(circle at 50% 42%, #20284D 0%, #0E1230 78%);
  box-shadow: 0 16rpx 40rpx rgba(30, 35, 90, 0.28);
  border: 1rpx solid rgba(138, 43, 39, 0.3);
}
.starhero-hover {
  opacity: 0.94;
}
.starhero-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.starhero-overlay {
  position: absolute;
  left: 30rpx;
  bottom: 28rpx;
  pointer-events: none;
}
.starhero-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #C7D2FF;
  background: rgba(138, 43, 39, 0.22);
  border: 1rpx solid rgba(138, 43, 39, 0.45);
  border-radius: 100rpx;
  padding: 4rpx 18rpx;
  letter-spacing: 1rpx;
}
.starhero-title {
  margin-top: 14rpx;
  font-size: 46rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 18rpx rgba(0, 0, 0, 0.4);
}
.starhero-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(220, 226, 255, 0.85);
}

/* 表单 */
.form {
  padding: 8rpx 32rpx 36rpx;
}
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--line);
}
.form-row.no-line {
  border-bottom: none;
}
.form-label {
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 500;
}
.form-note {
  font-size: 22rpx;
  color: var(--ink-3);
  font-weight: 400;
}
.form-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  margin-left: 24rpx;
  color: var(--ink);
}
.ph {
  color: var(--ink-3);
}
.form-picker {
  flex: 1;
  margin-left: 24rpx;
}
.picker-value {
  text-align: right;
  font-size: 30rpx;
  color: var(--ink);
}
.arrow {
  margin-left: 12rpx;
  color: var(--ink-3);
}

/* 性别 chips */
.chips {
  display: flex;
}
.chip {
  padding: 10rpx 28rpx;
  border-radius: 100rpx;
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  color: var(--ink-2);
  margin-left: 16rpx;
  background: var(--fill);
}
.chip-on {
  background: var(--tint);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 600;
}

/* 历法 segmented */
.seg {
  display: flex;
  background: var(--fill);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 4rpx;
}
.seg-item {
  padding: 8rpx 36rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}
.seg-on {
  background: linear-gradient(135deg, #8A2B27, #A3382F);
  color: #FFFFFF;
  font-weight: 600;
}

.btn-paipan {
  position: relative;
  margin-top: 36rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
  overflow: hidden;
  background: #8A2B27;
  box-shadow: 0 12rpx 30rpx rgba(138, 43, 39, 0.34);
}
.btn-paipan-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}
.btn-paipan-text {
  position: relative;
  z-index: 1;
  color: #FFF7E4;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
  text-shadow: 0 3rpx 10rpx rgba(61, 7, 5, 0.52);
}
/* 一键画像：黑金强调免费入口 */
.btn-quick {
  margin-top: 20rpx;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1.2;
  border-radius: 20rpx;
  background: #111111;
  border: 1rpx solid rgba(255, 216, 107, 0.78);
  box-shadow: 0 10rpx 24rpx rgba(17, 17, 17, 0.16);
}
.btn-quick::after {
  border: none;
}
.btn-quick.button-hover {
  opacity: 0.85;
}
.btn-quick-main {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #FFD86B;
}
.btn-quick-sub {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: rgba(255, 216, 107, 0.84);
  letter-spacing: 0;
}

/* 起盘过渡动画 */
.cast-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: radial-gradient(circle at 50% 38%, #5A1714 0%, #1B0808 48%, #080808 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: castFade 0.3s ease;
}
.cast-stage {
  position: relative;
  width: 420rpx;
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cast-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  animation: castSpin 7s linear infinite;
}
.cast-zhi {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  margin-left: -22rpx;
  margin-top: -22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #FFD86B;
  opacity: 0.9;
}
.cast-circle {
  position: absolute;
  width: 268rpx;
  height: 268rpx;
  border: 2rpx dashed rgba(255, 216, 107, 0.42);
  border-radius: 50%;
  animation: castSpinBack 11s linear infinite;
}
.cast-orb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #FFD86B, #A3382F 58%, #2A0505 100%);
  box-shadow: 0 0 54rpx rgba(255, 216, 107, 0.32), 0 0 150rpx rgba(138, 43, 39, 0.58);
  animation: castPulse 1.1s ease-in-out infinite alternate;
}
.cast-text {
  margin-top: 72rpx;
  font-size: 28rpx;
  color: #F6E7C8;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
  animation: castBlink 1.3s ease-in-out infinite;
}
@keyframes castSpin {
  to { transform: rotate(360deg); }
}
@keyframes castSpinBack {
  to { transform: rotate(-360deg); }
}
@keyframes castPulse {
  from { transform: scale(0.9); }
  to { transform: scale(1.08); }
}
@keyframes castFade {
  from { opacity: 0; }
}
@keyframes castBlink {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 1; }
}

/* 卡片按压态（最近排盘复用） */
.mod-hover {
  opacity: 0.85;
}

/* 最近排盘 */
.recent {
  margin-top: 40rpx;
}
.recent-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 0 8rpx 18rpx;
}
.recent-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.recent-more {
  font-size: 24rpx;
  color: var(--ink-3);
}
.recent-item {
  padding: 22rpx 28rpx;
  margin-bottom: 18rpx;
}
.recent-line1 {
  display: flex;
  align-items: center;
}
.recent-name {
  font-size: 30rpx;
  font-weight: 600;
}
.recent-gender {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
  color: #1A142E;
  font-weight: 600;
}
.g-m { background: #6FB6FF; }
.g-f { background: #F2A7C3; }
.recent-bazi {
  margin-left: auto;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
.bz-pillar {
  margin-left: 10rpx;
  font-weight: 600;
}
.recent-line2 {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.footer {
  margin-top: 56rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
}

/* 字号档位：大 */
.fs-l .form-label, .fs-l .picker-value, .fs-l .form-input { font-size: 32rpx; }
.fs-l .chip, .fs-l .seg-item { font-size: 28rpx; }
.fs-l .form-note { font-size: 24rpx; }
.fs-l .recent-name { font-size: 33rpx; }
.fs-l .recent-bazi { font-size: 29rpx; }
.fs-l .recent-line2 { font-size: 26rpx; }

/* 字号档位：特大 */
.fs-xl .form-label, .fs-xl .picker-value, .fs-xl .form-input { font-size: 36rpx; }
.fs-xl .chip, .fs-xl .seg-item { font-size: 30rpx; }
.fs-xl .form-note { font-size: 26rpx; }
.fs-xl .recent-name { font-size: 36rpx; }
.fs-xl .recent-bazi { font-size: 32rpx; }
.fs-xl .recent-line2 { font-size: 28rpx; }
.fs-xl .mod-title { font-size: 34rpx; }

/* 起盘过渡为深色覆盖层：局部回到亮色文字 */
.cast-mask {
  color: #F6E7C8;
  --ink-2: #F6E7C8;
  --primary: #FFD86B;
}
