<view class="page fs-{{fs}}">
  <image class="page-bg" src="/images/home-mystic-bg.jpg" mode="aspectFill" />

  <!-- 头部：LOGO + 标题 -->
  <view class="hero">
    <image class="logo" src="/images/logo-tongle-palace-gold.png" mode="aspectFill" />
    <view class="hero-right">
      <view class="hero-title serif">八字排盘</view>
      <view class="hero-sub">四柱八字 · 真太阳时 · 大运流年</view>
    </view>
    <view class="elder-toggle {{fs === 'xl' ? 'on' : ''}}" bindtap="toggleElder">
      <text class="elder-aa">A<text class="elder-aa-big">A</text></text>
      <text class="elder-tx">长辈模式</text>
    </view>
  </view>

  <!-- 此刻星象（程序亮点 · 默认展示） -->
  <view class="starhero" hover-class="starhero-hover" bindtap="goAstroNow">
    <starfield class="starhero-canvas" ts="{{0}}" flow="{{true}}" spin="{{true}}" />
    <view class="starhero-overlay">
      <view class="starhero-tag">星河实时演进</view>
      <view class="starhero-title serif">此刻星象</view>
      <view class="starhero-sub">日月五星正在运行 · 点击进入星图</view>
    </view>
  </view>

  <!-- 排盘表单 -->
  <view class="card form">
    <view class="form-row">
      <view class="form-label">姓名</view>
      <input class="form-input" placeholder="选填" placeholder-class="ph"
        value="{{name}}" bindinput="onNameInput" maxlength="12" />
    </view>

    <view class="form-row">
      <view class="form-label">性别</view>
      <view class="chips">
        <view class="chip {{gender === 1 ? 'chip-on' : ''}}" bindtap="onGenderTap" data-gender="1">乾造 · 男</view>
        <view class="chip {{gender === 0 ? 'chip-on' : ''}}" bindtap="onGenderTap" data-gender="0">坤造 · 女</view>
      </view>
    </view>

    <view class="form-row">
      <view class="form-label">历法</view>
      <view class="seg">
        <view class="seg-item {{calendar === 'solar' ? 'seg-on' : ''}}" bindtap="onCalendarTap" data-calendar="solar">公历</view>
        <view class="seg-item {{calendar === 'lunar' ? 'seg-on' : ''}}" bindtap="onCalendarTap" data-calendar="lunar">农历</view>
        <view class="seg-item {{calendar === 'pillar' ? 'seg-on' : ''}}" bindtap="onCalendarTap" data-calendar="pillar">四柱</view>
      </view>
    </view>

    <view class="form-row" wx:if="{{calendar === 'solar'}}">
      <view class="form-label">出生日期</view>
      <picker class="form-picker" mode="date"
        value="{{solarDate}}" start="{{minDate}}" end="{{maxDate}}" bindchange="onSolarDateChange">
        <view class="picker-value">{{solarDate}}</view>
      </picker>
    </view>

    <view class="form-row" wx:if="{{calendar === 'lunar'}}">
      <view class="form-label">出生日期</view>
      <picker class="form-picker" mode="multiSelector"
        range="{{lunarRange}}" value="{{lunarIndex}}"
        bindcolumnchange="onLunarColumnChange" bindchange="onLunarChange">
        <view class="picker-value">{{lunarText}}</view>
      </picker>
    </view>

    <view class="pillar-pane" wx:if="{{calendar === 'pillar'}}">
      <view class="direct-grid">
        <view class="direct-field">
          <text class="direct-label">年柱</text>
          <input class="direct-input" placeholder="甲子" maxlength="2" value="{{pillarQuery.year}}" bindinput="onPillarQueryInput" data-key="year" />
        </view>
        <view class="direct-field">
          <text class="direct-label">月柱</text>
          <input class="direct-input" placeholder="丙寅" maxlength="2" value="{{pillarQuery.month}}" bindinput="onPillarQueryInput" data-key="month" />
        </view>
        <view class="direct-field">
          <text class="direct-label">日柱</text>
          <input class="direct-input" placeholder="戊辰" maxlength="2" value="{{pillarQuery.day}}" bindinput="onPillarQueryInput" data-key="day" />
        </view>
        <view class="direct-field">
          <text class="direct-label">时柱</text>
          <input class="direct-input" placeholder="庚午" maxlength="2" value="{{pillarQuery.hour}}" bindinput="onPillarQueryInput" data-key="hour" />
        </view>
      </view>
      <view class="pillar-actions">
        <text class="pillar-msg" wx:if="{{pillarYearMsg}}">{{pillarYearMsg}}</text>
        <view class="pillar-btn" bindtap="onFindPillarYears">查找</view>
      </view>
      <view class="pillar-year-list" wx:if="{{pillarYearCandidates.length}}">
        <view class="pillar-year" wx:for="{{pillarYearCandidates}}" wx:key="year" bindtap="onPickPillarYear" data-index="{{index}}">
          <text class="pillar-year-main">{{item.year}}</text>
        </view>
      </view>
    </view>

    <view class="form-row" wx:if="{{calendar !== 'pillar'}}">
      <view class="form-label">知道出生时辰
        <view class="form-note">{{unknownTime ? '未知 · 只排年月日三柱' : '已知 · 排全四柱'}}</view>
      </view>
      <switch checked="{{!unknownTime}}" color="#8A2B27" bindchange="onKnowTimeChange" />
    </view>

    <view class="form-row" wx:if="{{calendar !== 'pillar' && !unknownTime}}">
      <view class="form-label">出生时间</view>
      <picker class="form-picker" mode="time" value="{{time}}" bindchange="onTimeChange">
        <view class="picker-value">{{time}}</view>
      </picker>
    </view>

    <view class="form-row" wx:if="{{calendar !== 'pillar'}}">
      <view class="form-label">出生地点</view>
      <picker class="form-picker" mode="multiSelector"
        range="{{regionRange}}" value="{{regionIndex}}"
        bindcolumnchange="onRegionColumnChange" bindchange="onRegionChange">
        <view class="picker-value">{{regionText}}</view>
      </picker>
    </view>

    <view class="form-row no-line" wx:if="{{calendar !== 'pillar' && !unknownTime}}">
      <view class="form-label">
        真太阳时
        <view class="form-note">按出生地经度与均时差修正</view>
      </view>
      <switch checked="{{useTrueSolar}}" color="#8A2B27" bindchange="onTrueSolarChange" />
    </view>

    <block wx:if="{{calendar !== 'pillar'}}">
      <button class="btn-primary btn-paipan" bindtap="onPaiPan">
        <image class="btn-paipan-bg" src="/images/btn-paipan-bg.jpg" mode="scaleToFill" />
        <text class="btn-paipan-text">开始排盘</text>
      </button>
      <button class="btn-quick" bindtap="onQuickXiangPi">
        <text class="btn-quick-main">获取性格画像</text>
        <text class="btn-quick-sub">看不懂排盘？直接看你的性格与天赋</text>
      </button>
    </block>
  </view>

  <!-- 最近排盘 -->
  <view class="recent" wx:if="{{recent.length > 0}}">
    <view class="recent-head">
      <view class="recent-title serif">最近排盘</view>
      <view class="recent-more" bindtap="goRecords">全部记录 &gt;</view>
    </view>
    <view class="recent-item card" wx:for="{{recent}}" wx:key="_id"
      hover-class="mod-hover" bindtap="goRecord" data-index="{{index}}">
      <view class="recent-line1">
        <text class="recent-name">{{item.name || '未署名'}}</text>
        <text class="recent-gender {{item.gender === 1 ? 'g-m' : 'g-f'}}">{{item.gender === 1 ? '乾' : '坤'}}</text>
        <view class="recent-bazi serif">
          <text class="bz-pillar" wx:for="{{item.bz}}" wx:for-item="gz" wx:key="index"><text class="wx-{{gz[0].cls}}">{{gz[0].text}}</text><text class="wx-{{gz[1].cls}}">{{gz[1].text}}</text></text>
        </view>
      </view>
      <view class="recent-line2">{{item.solarStr}}</view>
    </view>
  </view>

  <view class="footer">命盘仅供传统文化娱乐参考，不构成人生决策依据</view>

  <!-- 起盘过渡动画 -->
  <view class="cast-mask" wx:if="{{casting}}">
    <view class="cast-stage">
      <view class="cast-ring">
        <text class="cast-zhi serif" wx:for="{{zhiRing}}" wx:key="*this"
          style="transform: rotate({{index * 30}}deg) translateY(-168rpx);">{{item}}</text>
      </view>
      <view class="cast-circle"></view>
      <view class="cast-orb"></view>
    </view>
    <view class="cast-text">正在排盘</view>
  </view>
</view>
